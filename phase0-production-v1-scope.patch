+    },
+    {
+      "id": "author-application",
+      "decision": "required",
+      "readiness": "ready",
+      "productionExposure": "enabled",
+      "owner": "backend/author-applications + frontend/account",
+      "notes": "Author application and admin approval/rejection are in V1."
+    },
+    {
+      "id": "author-story-management",
+      "decision": "required",
+      "readiness": "ready",
+      "productionExposure": "enabled",
+      "owner": "backend/stories + frontend/author-portal",
+      "notes": "Author story lifecycle and immediate chapter publishing are in V1."
+    },
+    {
+      "id": "production-media",
+      "decision": "required",
+      "readiness": "blocked",
+      "productionExposure": "pending",
+      "owner": "backend/media + frontend upload flows + production config",
+      "nextPhase": "phase-4",
+      "blockingReason": "Production example config keeps CLOUDINARY_ENABLED=false; V1 requires verified production media credentials, presets and webhook configuration."
+    },
+    {
+      "id": "admin-operations",
+      "decision": "required",
+      "readiness": "ready",
+      "productionExposure": "enabled",
+      "owner": "backend/admin-facing modules + frontend/admin",
+      "notes": "User administration, story review, reports/moderation, taxonomy and audit-log read-side are in V1."
+    },
+    {
+      "id": "public-content-review",
+      "decision": "required",
+      "readiness": "blocked",
+      "productionExposure": "pending",
+      "owner": "frontend/public/static + product/legal",
+      "nextPhase": "phase-4",
+      "blockingReason": "Terms/privacy/about copy and historical/marketing claims still require production-owner review before public launch."
+    },
+    {
+      "id": "story-follow",
+      "decision": "deferred",
+      "readiness": "deferred",
+      "productionExposure": "hidden",
+      "owner": "planned reader engagement",
+      "nextPhase": "post-v1",
