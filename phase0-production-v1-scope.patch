+      "notes": "Register, login, refresh, logout, verification, reset/change password, sessions, MFA and account security are in V1."
+    },
+    {
+      "id": "reader-catalog-and-reading",
+      "decision": "required",
+      "readiness": "ready",
+      "productionExposure": "enabled",
+      "owner": "backend/stories+chapters + frontend/public",
