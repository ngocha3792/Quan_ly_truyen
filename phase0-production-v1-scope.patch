+    },
+    {
+      "id": "author-dashboard-advanced-goals-and-trends",
+      "decision": "deferred",
+      "readiness": "deferred",
+      "productionExposure": "hidden",
+      "owner": "planned author analytics",
+      "nextPhase": "post-v1",
+      "notes": "Heuristic monthly goals and synthetic directional trends are hidden until backed by persisted product semantics."
+    }
+  ],
+  "sourceGuards": [
+    {
+      "featureId": "story-follow",
+      "path": "frontend/src/app/features/account/reading-history",
+      "forbidden": ["followedStories"]
+    },
+    {
+      "featureId": "reader-weekly-reading-time",
