+      "readiness": "deferred",
+      "productionExposure": "hidden",
+      "owner": "planned reading analytics",
+      "nextPhase": "post-v1",
+      "notes": "ReadingSession may remain in schema; placeholder weekly-reading-time statistics are not shown in V1."
+    },
+    {
+      "id": "story-contributor-workflow",
