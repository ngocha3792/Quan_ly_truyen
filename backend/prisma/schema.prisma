  chapter    Chapter    @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@id([chapterId, mediaAssetId])
  @@unique([chapterId, sortOrder])
  @@index([mediaAssetId])
  @@map("chapter_media")
}

model Story {
  id            String          @id @default(uuid()) @db.Uuid
  authorId      String          @map("author_id") @db.Uuid
  title         String          @db.VarChar(255)
  slug          String          @unique @db.VarChar(255)
  synopsis      String          @db.Text
  languageCode  String          @default("vi") @map("language_code") @db.VarChar(10)
  status        StoryStatus     @default(DRAFT)
  visibility    StoryVisibility @default(PRIVATE)
  contentRating ContentRating   @default(TEEN) @map("content_rating")
  releaseYear   Int?            @map("release_year") @db.SmallInt
  coverMediaId  String?         @map("cover_media_id") @db.Uuid
  isFeatured    Boolean         @default(false) @map("is_featured")
  featuredOrder Int?            @map("featured_order")
  featuredUntil DateTime?       @map("featured_until") @db.Timestamptz(3)
  publishedAt   DateTime?       @map("published_at") @db.Timestamptz(3)
  completedAt   DateTime?       @map("completed_at") @db.Timestamptz(3)
  lastChapterAt DateTime?       @map("last_chapter_at") @db.Timestamptz(3)
  viewCount     BigInt          @default(0) @map("view_count")
  followerCount Int             @default(0) @map("follower_count")
  ratingCount   Int             @default(0) @map("rating_count")
  ratingAverage Decimal         @default(0) @map("rating_average") @db.Decimal(3, 2)
  chapterCount  Int             @default(0) @map("chapter_count")
  commentCount  Int             @default(0) @map("comment_count")
  version       Int             @default(1)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime?       @map("deleted_at") @db.Timestamptz(3)

  author            AuthorProfile      @relation(fields: [authorId], references: [userId], onDelete: Restrict)
  coverMedia        MediaAsset?        @relation("StoryCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  contributors      StoryContributor[]
  categories        StoryCategory[]
  tags              StoryTag[]
  chapters          Chapter[]
  comments          Comment[]
  ratings           Rating[]
  libraryEntries    LibraryEntry[]
  follows           StoryFollow[]
  readingProgress   ReadingProgress[]
  readingSessions   ReadingSession[]
  readingBookmarks  ReadingBookmark[]
  submissions       StorySubmission[]
  reports           Report[]           @relation("StoryReports")
  moderationActions ModerationAction[] @relation("ModerationStory")
  dailyStats        StoryDailyStat[]

  @@index([authorId, status, updatedAt])
  @@index([status, visibility, publishedAt])
  @@index([contentRating, status])
  @@index([releaseYear, status])
  @@index([isFeatured, featuredOrder, featuredUntil])
  @@index([lastChapterAt])
  @@index([deletedAt])
  @@map("stories")
}

model StoryContributor {
  storyId    String          @map("story_id") @db.Uuid
  userId     String          @map("user_id") @db.Uuid
  role       ContributorRole
  creditName String?         @map("credit_name") @db.VarChar(120)
  canEdit    Boolean         @default(false) @map("can_edit")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([storyId, userId, role])
  @@index([userId])
  @@map("story_contributors")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description   String?  @db.Text
  coverMediaId  String?  @map("cover_media_id") @db.Uuid
  visualKey     String?  @map("visual_key") @db.VarChar(50)
  tone          String?  @db.VarChar(30)
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  isFeatured    Boolean  @default(false) @map("is_featured")
  featuredOrder Int?     @map("featured_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent     Category?       @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   Category[]      @relation("CategoryTree")
  coverMedia MediaAsset?     @relation("CategoryCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  stories    StoryCategory[]

  @@index([parentId, sortOrder])
  @@index([isActive, sortOrder])
  @@index([isFeatured, featuredOrder])
  @@index([coverMediaId])
  @@map("categories")
}

model StoryCategory {
  storyId    String   @map("story_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([storyId, categoryId])
  @@index([categoryId, storyId])
  @@map("story_categories")
}

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(80)
  slug      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  stories StoryTag[]

  @@map("tags")
}

model StoryTag {
  storyId String @map("story_id") @db.Uuid
  tagId   String @map("tag_id") @db.Uuid

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([storyId, tagId])
  @@index([tagId, storyId])
  @@map("story_tags")
}

model Chapter {
  id            String        @id @default(uuid()) @db.Uuid
  storyId       String        @map("story_id") @db.Uuid
  createdById   String        @map("created_by_id") @db.Uuid
  updatedById   String        @map("updated_by_id") @db.Uuid
  number        Decimal       @db.Decimal(10, 2)
  title         String        @db.VarChar(255)
  slug          String        @db.VarChar(255)
  content       String        @db.Text
  contentFormat ContentFormat @default(MARKDOWN) @map("content_format")
  status        ChapterStatus @default(DRAFT)
  wordCount     Int           @default(0) @map("word_count")
  viewCount     BigInt        @default(0) @map("view_count")
  commentCount  Int           @default(0) @map("comment_count")
  version       Int           @default(1)
  scheduledAt   DateTime?     @map("scheduled_at") @db.Timestamptz(3)
  publishedAt   DateTime?     @map("published_at") @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime?     @map("deleted_at") @db.Timestamptz(3)

  story             Story              @relation(fields: [storyId], references: [id], onDelete: Cascade)
  createdBy         User               @relation("ChapterCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy         User               @relation("ChapterUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  versions          ChapterVersion[]
  media             ChapterMedia[]
  comments          Comment[]
  lastReadEntries   LibraryEntry[]     @relation("LibraryLastReadChapter")
  currentProgress   ReadingProgress[]  @relation("CurrentProgressChapter")
  readingSessions   ReadingSession[]
  readingBookmarks  ReadingBookmark[]
  reports           Report[]           @relation("ChapterReports")
  moderationActions ModerationAction[] @relation("ModerationChapter")
  dailyStats        ChapterDailyStat[]

  @@unique([storyId, number])
  @@unique([storyId, slug])
  @@unique([id, storyId], map: "chapters_id_story_id_unique")
  @@index([storyId, status, publishedAt])
  @@index([scheduledAt, status])
  @@index([deletedAt])
  @@map("chapters")
}

model ChapterVersion {
  id            String        @id @default(uuid()) @db.Uuid
  chapterId     String        @map("chapter_id") @db.Uuid
  createdById   String        @map("created_by_id") @db.Uuid
  version       Int
  title         String        @db.VarChar(255)
  content       String        @db.Text
  contentFormat ContentFormat @map("content_format")
  wordCount     Int           @map("word_count")
  changeSummary String?       @map("change_summary") @db.VarChar(500)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([chapterId, version])
  @@index([createdById])
  @@map("chapter_versions")
}

