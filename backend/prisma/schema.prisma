generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum AccountStatus {
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")
  BANNED    @map("banned")
  DELETED   @map("deleted")

  @@map("account_status")
}

enum AuthorVerificationStatus {
  PENDING  @map("pending")
  VERIFIED @map("verified")
  REJECTED @map("rejected")

  @@map("author_verification_status")
}

enum TokenType {
  EMAIL_VERIFICATION @map("email_verification")
  PASSWORD_RESET     @map("password_reset")
  CHANGE_EMAIL       @map("change_email")

  @@map("token_type")
}

enum OAuthProvider {
  GOOGLE   @map("google")
  FACEBOOK @map("facebook")
  GITHUB   @map("github")

  @@map("oauth_provider")
}

enum MfaMethod {
  TOTP @map("totp")

  @@map("mfa_method")
}

enum MfaCredentialStatus {
  PENDING  @map("pending")
  ENABLED  @map("enabled")
  DISABLED @map("disabled")

  @@map("mfa_credential_status")
}

enum AccountDeletionStatus {
  REQUESTED @map("requested")
  CANCELED  @map("canceled")
  COMPLETED @map("completed")

  @@map("account_deletion_status")
}

enum StoryStatus {
  DRAFT          @map("draft")
  PENDING_REVIEW @map("pending_review")
  REJECTED       @map("rejected")
  PUBLISHED      @map("published")
  HIATUS         @map("hiatus")
  SUSPENDED      @map("suspended")
  COMPLETED      @map("completed")
  ARCHIVED       @map("archived")

  @@map("story_status")
}

enum StoryVisibility {
  PUBLIC   @map("public")
  UNLISTED @map("unlisted")
  PRIVATE  @map("private")

  @@map("story_visibility")
}

enum ContentRating {
  EVERYONE @map("everyone")
  TEEN     @map("teen")
  MATURE   @map("mature")

  @@map("content_rating")
}

enum ContributorRole {
  CO_AUTHOR   @map("co_author")
  EDITOR      @map("editor")
  TRANSLATOR  @map("translator")
  ILLUSTRATOR @map("illustrator")

  @@map("contributor_role")
}

enum ChapterStatus {
  DRAFT     @map("draft")
  SCHEDULED @map("scheduled")
  PUBLISHED @map("published")
  HIDDEN    @map("hidden")
  ARCHIVED  @map("archived")

  @@map("chapter_status")
}

enum ContentFormat {
  MARKDOWN   @map("markdown")
  HTML       @map("html")
  PLAIN_TEXT @map("plain_text")

  @@map("content_format")
}

enum LibraryStatus {
  PLAN_TO_READ @map("plan_to_read")
  READING      @map("reading")
  COMPLETED    @map("completed")
  ON_HOLD      @map("on_hold")
  DROPPED      @map("dropped")

  @@map("library_status")
}

enum ModerationStatus {
  VISIBLE @map("visible")
  HIDDEN  @map("hidden")
  DELETED @map("deleted")

  @@map("moderation_status")
}

enum ReactionType {
  LIKE       @map("like")
  LOVE       @map("love")
  LAUGH      @map("laugh")
  INSIGHTFUL @map("insightful")

  @@map("reaction_type")
}

enum ReportTargetType {
  STORY   @map("story")
  CHAPTER @map("chapter")
  COMMENT @map("comment")
  USER    @map("user")

  @@map("report_target_type")
}

enum ReportReason {
  SPAM           @map("spam")
  HARASSMENT     @map("harassment")
  HATE_SPEECH    @map("hate_speech")
  SEXUAL_CONTENT @map("sexual_content")
  VIOLENCE       @map("violence")
  COPYRIGHT      @map("copyright")
  MISINFORMATION @map("misinformation")
  OTHER          @map("other")

  @@map("report_reason")
}

enum ReportStatus {
  OPEN      @map("open")
  IN_REVIEW @map("in_review")
  RESOLVED  @map("resolved")
  REJECTED  @map("rejected")

  @@map("report_status")
}

enum SubmissionStatus {
  PENDING  @map("pending")
  APPROVED @map("approved")
  REJECTED @map("rejected")
  CANCELED @map("canceled")

  @@map("submission_status")
}

enum ModerationActionType {
  APPROVE_STORY   @map("approve_story")
  REJECT_STORY    @map("reject_story")
  SUSPEND_STORY   @map("suspend_story")
  RESTORE_STORY   @map("restore_story")
  HIDE_CHAPTER    @map("hide_chapter")
  RESTORE_CHAPTER @map("restore_chapter")
  HIDE_COMMENT    @map("hide_comment")
  DELETE_COMMENT  @map("delete_comment")
  SUSPEND_USER    @map("suspend_user")
  BAN_USER        @map("ban_user")
  RESTORE_USER    @map("restore_user")

  @@map("moderation_action_type")
}

enum MediaStatus {
  PENDING       @map("pending")
  UPLOADED      @map("uploaded")
  PROCESSING    @map("processing")
  READY         @map("ready")
  FAILED        @map("failed")
  DELETING      @map("deleting")
  DELETE_FAILED @map("delete_failed")
  DELETED       @map("deleted")

  @@map("media_status")
}

enum MediaResourceType {
  IMAGE @map("image")
  VIDEO @map("video")
  RAW   @map("raw")

  @@map("media_resource_type")
}

enum MediaPurpose {
  AVATAR        @map("avatar")
  AUTHOR_BANNER @map("author_banner")
  STORY_COVER   @map("story_cover")
  GENRE_COVER   @map("genre_cover")
  CHAPTER_IMAGE @map("chapter_image")
  ATTACHMENT    @map("attachment")

  @@map("media_purpose")
}

enum OutboxStatus {
  PENDING    @map("pending")
  PROCESSING @map("processing")
  PUBLISHED  @map("published")
  FAILED     @map("failed")

  @@map("outbox_status")
}

enum InboundWebhookStatus {
  PENDING     @map("pending")
  PROCESSING  @map("processing")
  PROCESSED   @map("processed")
  IGNORED     @map("ignored")
  FAILED      @map("failed")
  DEAD_LETTER @map("dead_letter")

  @@map("inbound_webhook_status")
}

// ============================================================
// IDENTITY, AUTHENTICATION, AUTHORIZATION
// ============================================================

model User {
  id              String        @id @default(uuid()) @db.Uuid
  email           String        @unique @db.VarChar(320)
  username        String        @unique @db.VarChar(50)
  passwordHash    String?       @map("password_hash") @db.VarChar(255)
  displayName     String        @map("display_name") @db.VarChar(120)
  bio             String?       @db.Text
  status          AccountStatus @default(ACTIVE)
  emailVerifiedAt  DateTime?     @map("email_verified_at") @db.Timestamptz(3)
  passwordUpdatedAt DateTime?    @map("password_updated_at") @db.Timestamptz(3)
  lastLoginAt      DateTime?     @map("last_login_at") @db.Timestamptz(3)
  avatarMediaId   String?       @map("avatar_media_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(3)

  avatarMedia            MediaAsset?             @relation("UserAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  authorProfile          AuthorProfile?
  oauthAccounts          OAuthAccount[]
  adminMfaCredential     AdminMfaCredential?
  mfaCredentials         MfaCredential[]
  recoveryEmail          RecoveryEmail?
  securityQuestions      UserSecurityQuestion[]
  trustedDevices         TrustedDevice[]
  accountDeletionRequests AccountDeletionRequest[]
  sessions               Session[]
  tokens                 UserToken[]
  userRoles              UserRole[]              @relation("UserRoles")
  rolesAssigned          UserRole[]              @relation("AssignedUserRoles")
  uploadedMedia          MediaAsset[]            @relation("MediaUploader")
  storyContributions     StoryContributor[]
  chaptersCreated        Chapter[]               @relation("ChapterCreatedBy")
  chaptersUpdated        Chapter[]               @relation("ChapterUpdatedBy")
  chapterVersions        ChapterVersion[]
  comments               Comment[]
  commentReactions       CommentReaction[]
  ratings                Rating[]
  libraryEntries         LibraryEntry[]
  storyFollows           StoryFollow[]
  readingProgresses      ReadingProgress[]
  readingSessions        ReadingSession[]
  readingBookmarks       ReadingBookmark[]
  reportsFiled           Report[]                @relation("ReportsFiled")
  reportsAssigned        Report[]                @relation("ReportsAssigned")
  reportedInReports      Report[]                @relation("ReportedUserReports")
  storySubmissions       StorySubmission[]       @relation("StorySubmittedBy")
  storyReviews           StorySubmission[]       @relation("StoryReviewedBy")
  moderationActions      ModerationAction[]      @relation("ModerationActor")
  moderationTarget       ModerationAction[]      @relation("ModerationTargetUser")
  notifications          Notification[]
  notificationPreference NotificationPreference?
  auditLogs              AuditLog[]

  @@index([status, createdAt])
  @@index([deletedAt])
  @@map("users")
}

model OAuthAccount {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  provider          OAuthProvider
  providerAccountId String        @map("provider_account_id") @db.VarChar(255)
  expiresAt         DateTime?     @map("expires_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
  @@map("oauth_accounts")
}

model AdminMfaCredential {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @map("user_id") @db.Uuid
  encryptedSecret    String   @map("encrypted_secret") @db.Text
  recoveryCodeHashes String[] @map("recovery_code_hashes")
  lastUsedStep       BigInt?  @map("last_used_step")
  enabledAt          DateTime @map("enabled_at") @db.Timestamptz(3)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_mfa_credentials")
}

model MfaCredential {
  id               String              @id @default(uuid()) @db.Uuid
  userId           String              @map("user_id") @db.Uuid
  method           MfaMethod           @default(TOTP)
  status           MfaCredentialStatus @default(PENDING)
  encryptedSecret  String              @map("encrypted_secret") @db.Text
  enrollmentExpiresAt DateTime?         @map("enrollment_expires_at") @db.Timestamptz(3)
  enrolledDeviceName String?            @map("enrolled_device_name") @db.VarChar(200)
  lastUsedStep     BigInt?             @map("last_used_step")
  enabledAt        DateTime?           @map("enabled_at") @db.Timestamptz(3)
  disabledAt       DateTime?           @map("disabled_at") @db.Timestamptz(3)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  recoveryCodes MfaRecoveryCode[]

  @@unique([userId, method])
  @@index([status, enrollmentExpiresAt])
  @@map("mfa_credentials")
}

model MfaRecoveryCode {
  id           String    @id @default(uuid()) @db.Uuid
  credentialId String    @map("credential_id") @db.Uuid
  codeHash     String    @unique @map("code_hash") @db.VarChar(255)
  usedAt       DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  credential MfaCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([credentialId, usedAt])
  @@map("mfa_recovery_codes")
}

model RecoveryEmail {
  userId                     String    @id @map("user_id") @db.Uuid
  email                      String?   @db.VarChar(320)
  verifiedAt                 DateTime? @map("verified_at") @db.Timestamptz(3)
  pendingEmail               String?   @map("pending_email") @db.VarChar(320)
  pendingCodeHash            String?   @map("pending_code_hash") @db.VarChar(255)
  pendingRequestedAt         DateTime? @map("pending_requested_at") @db.Timestamptz(3)
  pendingExpiresAt           DateTime? @map("pending_expires_at") @db.Timestamptz(3)
  verificationSentAt         DateTime? @map("verification_sent_at") @db.Timestamptz(3)
  failedVerificationAttempts Int       @default(0) @map("failed_verification_attempts")
  resendCount                Int       @default(0) @map("resend_count")
  createdAt                  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([pendingExpiresAt])
  @@map("recovery_emails")
}

model SecurityQuestion {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(80)
  label     String   @db.VarChar(500)
  locale    String   @default("vi") @db.VarChar(10)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  userAnswers UserSecurityQuestion[]

  @@index([locale, isActive, sortOrder])
  @@map("security_questions")
}

model UserSecurityQuestion {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  questionId   String   @map("question_id") @db.Uuid
  answerHash   String   @map("answer_hash") @db.VarChar(255)
  position     Int      @db.SmallInt
  lastVerifiedAt DateTime? @map("last_verified_at") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  question SecurityQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([userId, questionId])
  @@unique([userId, position])
  @@index([questionId])
  @@map("user_security_questions")
}

model TrustedDevice {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  deviceId        String    @map("device_id") @db.VarChar(120)
  deviceName      String?   @map("device_name") @db.VarChar(200)
  fingerprintHash String?   @map("fingerprint_hash") @db.VarChar(255)
  trustTokenHash  String    @unique @map("trust_token_hash") @db.VarChar(255)
  trustedAt       DateTime  @default(now()) @map("trusted_at") @db.Timestamptz(3)
  lastUsedAt      DateTime? @map("last_used_at") @db.Timestamptz(3)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason   String?   @map("revoked_reason") @db.VarChar(120)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@unique([userId, deviceId])
  @@index([userId, revokedAt, expiresAt])
  @@map("trusted_devices")
}

model AccountDeletionRequest {
  id             String                @id @default(uuid()) @db.Uuid
  userId         String                @map("user_id") @db.Uuid
  status         AccountDeletionStatus @default(REQUESTED)
  reason         String?               @db.Text
  requestedAt    DateTime              @default(now()) @map("requested_at") @db.Timestamptz(3)
  scheduledFor   DateTime              @map("scheduled_for") @db.Timestamptz(3)
  canceledAt     DateTime?             @map("canceled_at") @db.Timestamptz(3)
  completedAt    DateTime?             @map("completed_at") @db.Timestamptz(3)
  requestIp      String?               @map("request_ip") @db.VarChar(45)
  requestUserAgent String?             @map("request_user_agent") @db.Text
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([userId, requestedAt])
  @@map("account_deletion_requests")
}

model Session {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  refreshTokenHash     String    @unique @map("refresh_token_hash") @db.VarChar(255)
  refreshTokenFamilyId String    @default(uuid()) @map("refresh_token_family_id") @db.Uuid
  refreshTokenVersion  Int       @default(0) @map("refresh_token_version")
  accessTokenVersion   Int       @default(0) @map("access_token_version")
  mfaVerifiedAt        DateTime? @map("mfa_verified_at") @db.Timestamptz(3)
  trustedDeviceId      String?   @map("trusted_device_id") @db.Uuid

  deviceId             String?   @map("device_id") @db.VarChar(120)
  deviceName           String?   @map("device_name") @db.VarChar(200)
  ipAddress             String?   @map("ip_address") @db.VarChar(45)
  userAgent             String?   @map("user_agent") @db.Text

  lastUsedAt            DateTime? @map("last_used_at") @db.Timestamptz(3)
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt             DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason         String?   @map("revoked_reason") @db.VarChar(120)

  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  trustedDevice TrustedDevice? @relation(fields: [trustedDeviceId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt])
  @@index([trustedDeviceId])
  @@index([refreshTokenFamilyId])
  @@index([expiresAt])
  @@map("sessions")
}

model UserToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  type       TokenType
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  payload    Json?
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("user_tokens")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  userRoles   UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(120)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  resource    String   @db.VarChar(80)
  action      String   @db.VarChar(80)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@index([resource, action])
  @@map("permissions")
}

model UserRole {
  userId       String    @map("user_id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  assignedById String?   @map("assigned_by_id") @db.Uuid
  assignedAt   DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(3)
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(3)

  user       User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("AssignedUserRoles", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([assignedById])
  @@index([expiresAt])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  grantedAt    DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ============================================================
// AUTHORS, MEDIA, STORIES, CHAPTERS
// ============================================================

model AuthorProfile {
  userId             String                   @id @map("user_id") @db.Uuid
  penName            String                   @unique @map("pen_name") @db.VarChar(120)
  slug               String                   @unique @db.VarChar(160)
  biography          String?                  @db.Text
  verificationStatus AuthorVerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt         DateTime?                @map("verified_at") @db.Timestamptz(3)
  websiteUrl         String?                  @map("website_url") @db.VarChar(500)
  socialLinks        Json?                    @map("social_links")
  bannerMediaId      String?                  @map("banner_media_id") @db.Uuid
  featuredRank       Int?                     @map("featured_rank")
  followerCount      Int                      @default(0) @map("follower_count")
  totalReadCount     BigInt                   @default(0) @map("total_read_count")
  storyCount         Int                      @default(0) @map("story_count")
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  bannerMedia MediaAsset? @relation("AuthorBanner", fields: [bannerMediaId], references: [id], onDelete: SetNull)
  stories     Story[]

  @@index([verificationStatus])
  @@index([featuredRank])
  @@index([followerCount])
  @@index([totalReadCount])
  @@map("author_profiles")
}

model MediaAsset {
  id                    String             @id @default(uuid()) @db.Uuid
  uploaderId            String?            @map("uploader_id") @db.Uuid
  purpose               MediaPurpose
  status                MediaStatus        @default(PENDING)
  storageProvider       String             @map("storage_provider") @db.VarChar(50)
  bucket                String?            @db.VarChar(120)
  storageKey            String?            @unique @map("storage_key") @db.VarChar(1024)
  publicUrl             String?            @map("public_url") @db.VarChar(2048)
  providerAssetId       String?            @unique @map("provider_asset_id") @db.VarChar(255)
  publicId              String?            @unique @map("public_id") @db.VarChar(512)
  version               Int?
  resourceType          MediaResourceType? @map("resource_type")
  deliveryType          String?            @map("delivery_type") @db.VarChar(50)
  format                String?            @db.VarChar(30)
  assetFolder           String?            @map("asset_folder") @db.VarChar(1024)
  secureUrl             String?            @map("secure_url") @db.VarChar(2048)
  originalName          String?            @map("original_name") @db.VarChar(255)
  mimeType              String?            @map("mime_type") @db.VarChar(120)
  sizeBytes             BigInt?            @map("size_bytes")
  checksumSha256        String?            @map("checksum_sha256") @db.VarChar(64)
  width                 Int?
  height                Int?
  duration              Decimal?           @db.Decimal(12, 3)
  uploadExpiresAt       DateTime?          @map("upload_expires_at") @db.Timestamptz(3)
  uploadedAt            DateTime?          @map("uploaded_at") @db.Timestamptz(3)
  readyAt               DateTime?          @map("ready_at") @db.Timestamptz(3)
  processingStartedAt   DateTime?          @map("processing_started_at") @db.Timestamptz(3)
  deleteAttempts        Int                @default(0) @map("delete_attempts")
  nextDeleteAttemptAt   DateTime?          @map("next_delete_attempt_at") @db.Timestamptz(3)
  lastProviderErrorCode String?            @map("last_provider_error_code") @db.VarChar(120)
  metadata              Json?
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime?          @map("deleted_at") @db.Timestamptz(3)

  uploader        User?           @relation("MediaUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  avatarOfUsers   User[]          @relation("UserAvatar")
  bannerOfAuthors AuthorProfile[] @relation("AuthorBanner")
  coverOfStories  Story[]         @relation("StoryCover")
  coverOfCategories Category[]     @relation("CategoryCover")
  chapterLinks    ChapterMedia[]

  @@index([uploaderId, createdAt])
  @@index([purpose, status])
  @@index([status, uploadExpiresAt])
  @@index([status, nextDeleteAttemptAt])
  @@index([storageProvider, providerAssetId])
  @@index([deletedAt])
  @@map("media_assets")
}

model ChapterMedia {
