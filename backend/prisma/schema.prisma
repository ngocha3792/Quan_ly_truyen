// ============================================================
// IDENTITY, AUTHENTICATION, AUTHORIZATION
// ============================================================

model User {
  id                String        @id @default(uuid()) @db.Uuid
  email             String        @unique @db.VarChar(320)
  username          String        @unique @db.VarChar(50)
  passwordHash      String?       @map("password_hash") @db.VarChar(255)
  displayName       String        @map("display_name") @db.VarChar(120)
  bio               String?       @db.Text
  status            AccountStatus @default(ACTIVE)
  emailVerifiedAt   DateTime?     @map("email_verified_at") @db.Timestamptz(3)
  passwordUpdatedAt DateTime?     @map("password_updated_at") @db.Timestamptz(3)
  lastLoginAt       DateTime?     @map("last_login_at") @db.Timestamptz(3)
  avatarMediaId     String?       @map("avatar_media_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?     @map("deleted_at") @db.Timestamptz(3)

  authorApplication            AuthorApplication?         @relation("AuthorApplicationOwner")
  authorApplicationsReviewed   AuthorApplication[]        @relation("AuthorApplicationReviewer")
  avatarMedia                  MediaAsset?                @relation("UserAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  authorProfile                AuthorProfile?
  oauthAccounts                OAuthAccount[]
  adminMfaCredential           AdminMfaCredential?
  mfaCredentials               MfaCredential[]
  recoveryEmail                RecoveryEmail?
  securityQuestions            UserSecurityQuestion[]
  trustedDevices               TrustedDevice[]
  accountDeletionRequests      AccountDeletionRequest[]
  sessions                     Session[]
  tokens                       UserToken[]
  userRoles                    UserRole[]                 @relation("UserRoles")
  rolesAssigned                UserRole[]                 @relation("AssignedUserRoles")
  uploadedMedia                MediaAsset[]               @relation("MediaUploader")
  storyContributions           StoryContributor[]
  chaptersCreated              Chapter[]                  @relation("ChapterCreatedBy")
  chaptersUpdated              Chapter[]                  @relation("ChapterUpdatedBy")
  chapterVersions              ChapterVersion[]
  comments                     Comment[]
  commentReactions             CommentReaction[]
  ratings                      Rating[]
  libraryEntries               LibraryEntry[]
  storyFollows                 StoryFollow[]
  authorFollows                UserFollowAuthor[]         @relation("UserAuthorFollows")
  readingProgresses            ReadingProgress[]
  readingProgressSyncEvents    ReadingProgressSyncEvent[]
  readingSessions              ReadingSession[]
  readingBookmarks             ReadingBookmark[]
  readingGoal                  ReadingGoal?
  readerAnalyticsEvents        ReaderAnalyticsEvent[]
  reportsFiled                 Report[]                   @relation("ReportsFiled")
  reportsAssigned              Report[]                   @relation("ReportsAssigned")
  reportedInReports            Report[]                   @relation("ReportedUserReports")
  storySubmissions             StorySubmission[]          @relation("StorySubmittedBy")
  storyReviews                 StorySubmission[]          @relation("StoryReviewedBy")
  moderationActions            ModerationAction[]         @relation("ModerationActor")
  moderationTarget             ModerationAction[]         @relation("ModerationTargetUser")
  notifications                Notification[]
  notificationPreference       NotificationPreference?
  auditLogs                    AuditLog[]
  aiConnections                AiConnection[]
  aiConversations              AiConversation[]
  aiUsages                     AiUsage[]
  aiPolicy                     AiUserPolicy?
  aiProfile                    AiUserProfile?
  aiStoryProfiles              AiStoryProfile[]
  aiRateLimitBuckets           AiRateLimitBucket[]
  chapterTranslationsRequested ChapterTranslation[]
  wallets                      Wallet[]
  chapterPurchases             ChapterPurchase[]
  chapterPurchasesRefunded     ChapterPurchase[]          @relation("ChapterPurchaseRefundedBy")
  chapterEntitlements          ChapterEntitlement[]
  chapterMonetizationUpdates   ChapterMonetization[]      @relation("ChapterMonetizationUpdatedBy")
  chapterPricingVersions       ChapterPricingVersion[]    @relation("ChapterPricingVersionChangedBy")
  paymentOrders                PaymentOrder[]

  @@index([status, createdAt])
  @@index([deletedAt])
  @@map("users")
}

// ============================================================
// WALLET AND IMMUTABLE DOUBLE-ENTRY LEDGER
// ============================================================

model Wallet {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  currency  WalletCurrency @default(CREDIT)
  balance   BigInt         @default(0)
  version   Int            @default(0)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions  WalletLedgerTransaction[]
  ledgerEntries WalletLedgerEntry[]

  @@unique([userId, currency], map: "wallets_user_currency_unique")
  @@index([userId, updatedAt])
  @@map("wallets")
}

model WalletLedgerTransaction {
  id                 String                @id @default(uuid()) @db.Uuid
  walletId           String                @map("wallet_id") @db.Uuid
  currency           WalletCurrency
  type               WalletTransactionType
  idempotencyKey     String                @unique(map: "wallet_ledger_transactions_idempotency_key_unique") @map("idempotency_key") @db.VarChar(200)
  requestHash        String                @map("request_hash") @db.VarChar(64)
  referenceType      String                @map("reference_type") @db.VarChar(100)
  referenceId        String                @map("reference_id") @db.VarChar(100)
  walletAmount       BigInt                @map("wallet_amount")
  walletBalanceAfter BigInt                @map("wallet_balance_after")
  metadata           Json?
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  wallet                Wallet              @relation(fields: [walletId], references: [id], onDelete: Restrict)
  entries               WalletLedgerEntry[]
  chapterPurchase       ChapterPurchase?    @relation("ChapterPurchaseDebit")
  chapterPurchaseRefund ChapterPurchase?    @relation("ChapterPurchaseRefund")
  paymentOrder          PaymentOrder?

  @@unique([walletId, type, referenceType, referenceId], map: "wallet_ledger_transactions_business_reference_unique")
  @@index([walletId, createdAt, id], map: "wallet_ledger_transactions_wallet_history_idx")
  @@map("wallet_ledger_transactions")
}

model WalletLedgerEntry {
  id            String               @id @default(uuid()) @db.Uuid
  transactionId String               @map("transaction_id") @db.Uuid
  walletId      String?              @map("wallet_id") @db.Uuid
  systemAccount WalletSystemAccount? @map("system_account")
  currency      WalletCurrency
  amount        BigInt
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  transaction WalletLedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  wallet      Wallet?                 @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@unique([transactionId, walletId], map: "wallet_ledger_entries_transaction_wallet_unique")
  @@unique([transactionId, systemAccount], map: "wallet_ledger_entries_transaction_system_unique")
  @@index([walletId, createdAt, id], map: "wallet_ledger_entries_wallet_history_idx")
  @@map("wallet_ledger_entries")
}

// ============================================================
// CHAPTER MONETIZATION, PURCHASES AND ENTITLEMENTS
// ============================================================

model MonetizationPriceBand {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50)
  label       String   @db.VarChar(120)
  creditPrice BigInt   @map("credit_price")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  chapterMonetizations ChapterMonetization[]
  pricingVersions      ChapterPricingVersion[]
  purchases            ChapterPurchase[]

  @@index([isActive, sortOrder])
  @@map("monetization_price_bands")
}

model ChapterMonetization {
  chapterId      String            @id @map("chapter_id") @db.Uuid
  accessType     ChapterAccessType @default(FREE) @map("access_type")
  priceBandId    String?           @map("price_band_id") @db.Uuid
  creditPrice    BigInt?           @map("credit_price")
  previewContent String?           @map("preview_content") @db.Text
  version        Int               @default(1)
  updatedById    String?           @map("updated_by_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  chapter   Chapter                @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  priceBand MonetizationPriceBand? @relation(fields: [priceBandId], references: [id], onDelete: Restrict)
  updatedBy User?                  @relation("ChapterMonetizationUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([accessType, updatedAt])
  @@index([priceBandId])
  @@map("chapter_monetization")
}

model ChapterPricingVersion {
  id             String            @id @default(uuid()) @db.Uuid
  chapterId      String            @map("chapter_id") @db.Uuid
  version        Int
  accessType     ChapterAccessType @map("access_type")
  priceBandId    String?           @map("price_band_id") @db.Uuid
  creditPrice    BigInt?           @map("credit_price")
  previewContent String?           @map("preview_content") @db.Text
  changedById    String            @map("changed_by_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  chapter   Chapter                @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  priceBand MonetizationPriceBand? @relation(fields: [priceBandId], references: [id], onDelete: Restrict)
  changedBy User                   @relation("ChapterPricingVersionChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@unique([chapterId, version])
  @@index([changedById, createdAt])
  @@map("chapter_pricing_versions")
}

model ChapterPurchase {
  id                        String                @id @default(uuid()) @db.Uuid
  userId                    String                @map("user_id") @db.Uuid
  chapterId                 String                @map("chapter_id") @db.Uuid
  priceBandId               String?               @map("price_band_id") @db.Uuid
  creditPrice               BigInt                @map("credit_price")
  status                    ChapterPurchaseStatus @default(COMPLETED)
  walletTransactionId       String                @unique(map: "chapter_purchases_wallet_transaction_key") @map("wallet_transaction_id") @db.Uuid
  refundWalletTransactionId String?               @unique(map: "chapter_purchases_refund_wallet_transaction_key") @map("refund_wallet_transaction_id") @db.Uuid
  idempotencyKey            String                @unique @map("idempotency_key") @db.VarChar(200)
  requestHash               String                @map("request_hash") @db.VarChar(64)
  createdAt                 DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  refundedAt                DateTime?             @map("refunded_at") @db.Timestamptz(3)
  refundReason              String?               @map("refund_reason") @db.VarChar(500)
  refundedById              String?               @map("refunded_by_id") @db.Uuid

  user                    User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  chapter                 Chapter                  @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  priceBand               MonetizationPriceBand?   @relation(fields: [priceBandId], references: [id], onDelete: SetNull)
  walletTransaction       WalletLedgerTransaction  @relation("ChapterPurchaseDebit", fields: [walletTransactionId], references: [id], onDelete: Restrict)
  refundWalletTransaction WalletLedgerTransaction? @relation("ChapterPurchaseRefund", fields: [refundWalletTransactionId], references: [id], onDelete: Restrict)
  refundedBy              User?                    @relation("ChapterPurchaseRefundedBy", fields: [refundedById], references: [id], onDelete: Restrict)
  entitlement             ChapterEntitlement?

  @@index([userId, createdAt, id])
  @@index([chapterId, createdAt])
  @@index([status, createdAt, id], map: "chapter_purchases_status_created_idx")
  @@index([refundedById, refundedAt], map: "chapter_purchases_refunder_refunded_idx")
  @@map("chapter_purchases")
}

model ChapterEntitlement {
  id         String                   @id @default(uuid()) @db.Uuid
  userId     String                   @map("user_id") @db.Uuid
  chapterId  String                   @map("chapter_id") @db.Uuid
  purchaseId String                   @unique @map("purchase_id") @db.Uuid
  status     ChapterEntitlementStatus @default(ACTIVE)
  grantedAt  DateTime                 @default(now()) @map("granted_at") @db.Timestamptz(3)
  revokedAt  DateTime?                @map("revoked_at") @db.Timestamptz(3)

  user     User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  chapter  Chapter         @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  purchase ChapterPurchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  @@unique([userId, chapterId])
  @@index([chapterId, status])
  @@map("chapter_entitlements")
}

// ============================================================
// BILLING, CREDIT PACKAGES AND PAYMENT ORDERS
// ============================================================

model CreditPackage {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique @db.VarChar(50)
  label           String   @db.VarChar(120)
  creditAmount    BigInt   @map("credit_amount")
  fiatAmountMinor BigInt   @map("fiat_amount_minor")
  currency        String   @db.VarChar(3)
  isActive        Boolean  @default(false) @map("is_active")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  orders PaymentOrder[]

  @@index([isActive, sortOrder])
  @@map("credit_packages")
}

model PaymentProviderConnection {
  id                  String              @id @default(uuid()) @db.Uuid
  code                String              @unique @db.VarChar(50)
  kind                PaymentProviderKind
  displayName         String              @map("display_name") @db.VarChar(120)
