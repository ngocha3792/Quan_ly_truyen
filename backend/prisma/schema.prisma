model Story {
  id            String          @id @default(uuid()) @db.Uuid
  authorId      String          @map("author_id") @db.Uuid
  title         String          @db.VarChar(255)
  slug          String          @unique @db.VarChar(255)
  synopsis      String          @db.Text
  languageCode  String          @default("vi") @map("language_code") @db.VarChar(10)
  status        StoryStatus     @default(DRAFT)
  visibility    StoryVisibility @default(PRIVATE)
  contentRating ContentRating   @default(TEEN) @map("content_rating")
  releaseYear   Int?            @map("release_year") @db.SmallInt
  coverMediaId  String?         @map("cover_media_id") @db.Uuid
  isFeatured    Boolean         @default(false) @map("is_featured")
  featuredOrder Int?            @map("featured_order")
  featuredUntil DateTime?       @map("featured_until") @db.Timestamptz(3)
  publishedAt   DateTime?       @map("published_at") @db.Timestamptz(3)
  completedAt   DateTime?       @map("completed_at") @db.Timestamptz(3)
  lastChapterAt DateTime?       @map("last_chapter_at") @db.Timestamptz(3)
  viewCount     BigInt          @default(0) @map("view_count")
  followerCount Int             @default(0) @map("follower_count")
  ratingCount   Int             @default(0) @map("rating_count")
  ratingAverage Decimal         @default(0) @map("rating_average") @db.Decimal(3, 2)
  chapterCount  Int             @default(0) @map("chapter_count")
  commentCount  Int             @default(0) @map("comment_count")
  version       Int             @default(1)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime?       @map("deleted_at") @db.Timestamptz(3)

  author                    AuthorProfile              @relation(fields: [authorId], references: [userId], onDelete: Restrict)
  coverMedia                MediaAsset?                @relation("StoryCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  contributors              StoryContributor[]
  categories                StoryCategory[]
  tags                      StoryTag[]
  aiProfile                 AiStoryProfile?
  chapters                  Chapter[]
  comments                  Comment[]
  ratings                   Rating[]
  libraryEntries            LibraryEntry[]
  follows                   StoryFollow[]
  readingProgress           ReadingProgress[]
  readingProgressSyncEvents ReadingProgressSyncEvent[]
  readingSessions           ReadingSession[]
  readingBookmarks          ReadingBookmark[]
  submissions               StorySubmission[]
  reports                   Report[]                   @relation("StoryReports")
  moderationActions         ModerationAction[]         @relation("ModerationStory")
  dailyStats                StoryDailyStat[]
  analyticsEvents           ReaderAnalyticsEvent[]

  @@index([authorId, status, updatedAt])
  @@index([status, visibility, publishedAt])
  @@index([contentRating, status])
  @@index([releaseYear, status])
  @@index([isFeatured, featuredOrder, featuredUntil])
  @@index([lastChapterAt])
  @@index([deletedAt])
  @@map("stories")
}

model StoryContributor {
