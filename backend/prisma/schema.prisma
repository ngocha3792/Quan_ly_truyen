// ============================================================

model LibraryEntry {
  userId            String        @map("user_id") @db.Uuid
  storyId           String        @map("story_id") @db.Uuid
  status            LibraryStatus @default(PLAN_TO_READ)
  isFavorite        Boolean       @default(false) @map("is_favorite")
  lastReadChapterId String?       @map("last_read_chapter_id") @db.Uuid
  progressPercent   Decimal       @default(0) @map("progress_percent") @db.Decimal(5, 2)
  startedAt         DateTime?     @map("started_at") @db.Timestamptz(3)
  completedAt       DateTime?     @map("completed_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  story           Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  lastReadChapter Chapter? @relation("LibraryLastReadChapter", fields: [lastReadChapterId], references: [id], onDelete: SetNull)

  @@id([userId, storyId])
  @@index([userId, status, updatedAt])
  @@index([storyId, status])
  @@index([lastReadChapterId])
  @@map("library_entries")
}

model StoryFollow {
  userId               String   @map("user_id") @db.Uuid
  storyId              String   @map("story_id") @db.Uuid
  notificationsEnabled Boolean  @default(true) @map("notifications_enabled")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@id([userId, storyId])
  @@index([storyId, createdAt])
  @@map("story_follows")
}

model Rating {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  storyId          String           @map("story_id") @db.Uuid
  score            Int              @db.SmallInt
  review           String?          @db.Text
  moderationStatus ModerationStatus @default(VISIBLE) @map("moderation_status")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId])
  @@index([storyId, moderationStatus, createdAt])
  @@index([deletedAt])
  @@map("ratings")
}

model Comment {
  id               String           @id @default(uuid()) @db.Uuid
  storyId          String           @map("story_id") @db.Uuid
  chapterId        String?          @map("chapter_id") @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  parentId         String?          @map("parent_id") @db.Uuid
  body             String           @db.Text
  moderationStatus ModerationStatus @default(VISIBLE) @map("moderation_status")
  likeCount        Int              @default(0) @map("like_count")
  replyCount       Int              @default(0) @map("reply_count")
  editedAt         DateTime?        @map("edited_at") @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz(3)

  story             Story              @relation(fields: [storyId], references: [id], onDelete: Cascade)
  chapter           Chapter?           @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  parent            Comment?           @relation("CommentThread", fields: [parentId], references: [id], onDelete: SetNull)
  replies           Comment[]          @relation("CommentThread")
  reactions         CommentReaction[]
  reports           Report[]           @relation("CommentReports")
  moderationActions ModerationAction[] @relation("ModerationComment")

  @@index([storyId, moderationStatus, createdAt])
  @@index([chapterId, moderationStatus, createdAt])
  @@index([parentId, createdAt])
  @@index([userId, createdAt])
  @@index([deletedAt])
  @@map("comments")
}

model CommentReaction {
  commentId String       @map("comment_id") @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  type      ReactionType
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId, createdAt])
  @@map("comment_reactions")
}

model ReadingBookmark {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  storyId   String   @map("story_id") @db.Uuid
  chapterId String   @map("chapter_id") @db.Uuid
  position  Int      @default(0)
  label     String?  @db.VarChar(200)
  note      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  story   Story   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId, position])
  @@index([userId, createdAt])
  @@index([storyId, chapterId])
  @@map("reading_bookmarks")
}

model ReadingProgress {
  userId           String   @map("user_id") @db.Uuid
  storyId          String   @map("story_id") @db.Uuid
  currentChapterId String?  @map("current_chapter_id") @db.Uuid
  position         Int      @default(0)
  progressPercent  Decimal  @default(0) @map("progress_percent") @db.Decimal(5, 2)
  lastReadAt       DateTime @default(now()) @map("last_read_at") @db.Timestamptz(3)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  story          Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  currentChapter Chapter? @relation("CurrentProgressChapter", fields: [currentChapterId], references: [id], onDelete: SetNull)

  @@id([userId, storyId])
  @@index([userId, lastReadAt])
  @@index([storyId, lastReadAt])
  @@index([currentChapterId])
  @@map("reading_progress")
}

model ReadingSession {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  storyId         String    @map("story_id") @db.Uuid
  chapterId       String    @map("chapter_id") @db.Uuid
  startedAt       DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt         DateTime? @map("ended_at") @db.Timestamptz(3)
  durationSeconds Int?      @map("duration_seconds")
  startPosition   Int       @default(0) @map("start_position")
  endPosition     Int?      @map("end_position")
  completed       Boolean   @default(false)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  story   Story   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([storyId, startedAt])
  @@index([chapterId, startedAt])
  @@map("reading_sessions")
}

// ============================================================
// MODERATION, REPORTING, NOTIFICATIONS, AUDITING
// ============================================================

model StorySubmission {
  id            String           @id @default(uuid()) @db.Uuid
  storyId       String           @map("story_id") @db.Uuid
  submittedById String           @map("submitted_by_id") @db.Uuid
  reviewedById  String?          @map("reviewed_by_id") @db.Uuid
  status        SubmissionStatus @default(PENDING)
  authorNote    String?          @map("author_note") @db.Text
  reviewerNote  String?          @map("reviewer_note") @db.Text
  submittedAt   DateTime         @default(now()) @map("submitted_at") @db.Timestamptz(3)
  reviewedAt    DateTime?        @map("reviewed_at") @db.Timestamptz(3)
  canceledAt    DateTime?        @map("canceled_at") @db.Timestamptz(3)

  story             Story              @relation(fields: [storyId], references: [id], onDelete: Cascade)
  submittedBy       User               @relation("StorySubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedBy        User?              @relation("StoryReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  moderationActions ModerationAction[]

  @@index([storyId, status, submittedAt])
  @@index([reviewedById, status])
  @@map("story_submissions")
}

model Report {
  id             String           @id @default(uuid()) @db.Uuid
  reporterId     String           @map("reporter_id") @db.Uuid
  assignedToId   String?          @map("assigned_to_id") @db.Uuid
  targetType     ReportTargetType @map("target_type")
  storyId        String?          @map("story_id") @db.Uuid
  chapterId      String?          @map("chapter_id") @db.Uuid
  commentId      String?          @map("comment_id") @db.Uuid
  reportedUserId String?          @map("reported_user_id") @db.Uuid
  reason         ReportReason
  description    String?          @db.Text
  evidence       Json?
  status         ReportStatus     @default(OPEN)
  resolutionNote String?          @map("resolution_note") @db.Text
  resolvedAt     DateTime?        @map("resolved_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  reporter          User               @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Restrict)
  assignedTo        User?              @relation("ReportsAssigned", fields: [assignedToId], references: [id], onDelete: SetNull)
  story             Story?             @relation("StoryReports", fields: [storyId], references: [id], onDelete: Cascade)
  chapter           Chapter?           @relation("ChapterReports", fields: [chapterId], references: [id], onDelete: Cascade)
  comment           Comment?           @relation("CommentReports", fields: [commentId], references: [id], onDelete: Cascade)
  reportedUser      User?              @relation("ReportedUserReports", fields: [reportedUserId], references: [id], onDelete: Cascade)
  moderationActions ModerationAction[]

  @@index([status, createdAt])
  @@index([assignedToId, status])
  @@index([storyId])
  @@index([chapterId])
  @@index([commentId])
  @@index([reportedUserId])
  @@map("reports")
}

model ModerationAction {
  id           String               @id @default(uuid()) @db.Uuid
  actorId      String               @map("actor_id") @db.Uuid
  reportId     String?              @map("report_id") @db.Uuid
  submissionId String?              @map("submission_id") @db.Uuid
  storyId      String?              @map("story_id") @db.Uuid
  chapterId    String?              @map("chapter_id") @db.Uuid
  commentId    String?              @map("comment_id") @db.Uuid
  targetUserId String?              @map("target_user_id") @db.Uuid
  action       ModerationActionType
  reason       String?              @db.Text
  metadata     Json?
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  actor      User             @relation("ModerationActor", fields: [actorId], references: [id], onDelete: Restrict)
  report     Report?          @relation(fields: [reportId], references: [id], onDelete: SetNull)
  submission StorySubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  story      Story?           @relation("ModerationStory", fields: [storyId], references: [id], onDelete: SetNull)
  chapter    Chapter?         @relation("ModerationChapter", fields: [chapterId], references: [id], onDelete: SetNull)
  comment    Comment?         @relation("ModerationComment", fields: [commentId], references: [id], onDelete: SetNull)
  targetUser User?            @relation("ModerationTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([reportId])
  @@index([submissionId])
  @@index([storyId])
  @@index([chapterId])
  @@index([commentId])
  @@index([targetUserId])
  @@map("moderation_actions")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String    @db.VarChar(100)
  title     String    @db.VarChar(255)
  body      String    @db.Text
  data      Json?
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([expiresAt])
  @@map("notifications")
}

model NotificationPreference {
  userId              String   @id @map("user_id") @db.Uuid
  emailEnabled        Boolean  @default(true) @map("email_enabled")
  pushEnabled         Boolean  @default(true) @map("push_enabled")
  inAppEnabled        Boolean  @default(true) @map("in_app_enabled")
  newChapterEnabled   Boolean  @default(true) @map("new_chapter_enabled")
  commentReplyEnabled Boolean  @default(true) @map("comment_reply_enabled")
  moderationEnabled   Boolean  @default(true) @map("moderation_enabled")
  preferences         Json?
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(120)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String?  @map("entity_id") @db.VarChar(100)
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  metadata   Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.Text
  requestId  String?  @map("request_id") @db.VarChar(100)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([requestId])
  @@map("audit_logs")
}

model OutboxEvent {
  id                  String       @id @default(uuid()) @db.Uuid
  idempotencyKey      String?      @unique @map("idempotency_key") @db.VarChar(200)
  aggregateType       String       @map("aggregate_type") @db.VarChar(100)
  aggregateId         String       @map("aggregate_id") @db.VarChar(100)
  eventType           String       @map("event_type") @db.VarChar(150)
  payload             Json
  metadata            Json?
  status              OutboxStatus @default(PENDING)
  attempts            Int          @default(0)
  availableAt         DateTime     @default(now()) @map("available_at") @db.Timestamptz(3)
  processedAt         DateTime?    @map("processed_at") @db.Timestamptz(3)
  processingStartedAt DateTime?    @map("processing_started_at") @db.Timestamptz(3)
  processingToken     String?      @map("processing_token") @db.Uuid
  lastError           String?      @map("last_error") @db.Text
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, availableAt])
  @@index([status, processingStartedAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
  @@index([aggregateType, eventType, status, processedAt],map: "outbox_events_retention_idx")
}

model InboundWebhookEvent {
  id                  String               @id @default(uuid()) @db.Uuid
  provider            String               @db.VarChar(50)
  eventKey            String               @map("event_key") @db.VarChar(255)
  payloadHash         String               @map("payload_hash") @db.VarChar(64)
  eventType           String?              @map("event_type") @db.VarChar(120)
  status              InboundWebhookStatus @default(PENDING)
  payload             Json
  receivedAt          DateTime             @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt         DateTime?            @map("processed_at") @db.Timestamptz(3)
  attempts            Int                  @default(0)
  lastError           String?              @map("last_error") @db.Text
  nextAttemptAt       DateTime             @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  processingStartedAt DateTime?            @map("processing_started_at") @db.Timestamptz(3)

  @@unique([provider, eventKey])
  @@index([provider, status, receivedAt])
  @@index([provider, status, nextAttemptAt])
  @@map("inbound_webhook_events")
}

// ============================================================
// AGGREGATED ANALYTICS
// ============================================================

model StoryDailyStat {
  storyId        String   @map("story_id") @db.Uuid
  date           DateTime @db.Date
  viewCount      BigInt   @default(0) @map("view_count")
  uniqueReaders  Int      @default(0) @map("unique_readers")
  followCount    Int      @default(0) @map("follow_count")
  ratingCount    Int      @default(0) @map("rating_count")
  commentCount   Int      @default(0) @map("comment_count")
  readingSeconds BigInt   @default(0) @map("reading_seconds")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@id([storyId, date])
  @@index([date, viewCount])
  @@map("story_daily_stats")
}

model ChapterDailyStat {
  chapterId       String   @map("chapter_id") @db.Uuid
  date            DateTime @db.Date
  viewCount       BigInt   @default(0) @map("view_count")
  uniqueReaders   Int      @default(0) @map("unique_readers")
  completionCount Int      @default(0) @map("completion_count")
  readingSeconds  BigInt   @default(0) @map("reading_seconds")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@id([chapterId, date])
  @@index([date, viewCount])
  @@map("chapter_daily_stats")
}
