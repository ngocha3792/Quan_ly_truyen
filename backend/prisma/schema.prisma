  slug                  String        @db.VarChar(255)
  content               String        @db.Text
  contentDocument       Json?         @map("content_document") @db.JsonB
  documentSchemaVersion Int?          @map("document_schema_version")
  contentFormat         ContentFormat @default(MARKDOWN) @map("content_format")
  status                ChapterStatus @default(DRAFT)
  wordCount             Int           @default(0) @map("word_count")
  viewCount             BigInt        @default(0) @map("view_count")
  commentCount          Int           @default(0) @map("comment_count")
  version               Int           @default(1)
  scheduledAt           DateTime?     @map("scheduled_at") @db.Timestamptz(3)
  publishedAt           DateTime?     @map("published_at") @db.Timestamptz(3)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime?     @map("deleted_at") @db.Timestamptz(3)

  story             Story                   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  createdBy         User                    @relation("ChapterCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy         User                    @relation("ChapterUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  versions          ChapterVersion[]
  media             ChapterMedia[]
  comments          Comment[]
  lastReadEntries   LibraryEntry[]          @relation("LibraryLastReadChapter")
  currentProgress   ReadingProgress[]       @relation("CurrentProgressChapter")
  readingSessions   ReadingSession[]
  readingBookmarks  ReadingBookmark[]
  reports           Report[]                @relation("ChapterReports")
  moderationActions ModerationAction[]      @relation("ModerationChapter")
  dailyStats        ChapterDailyStat[]
  analyticsEvents   ReaderAnalyticsEvent[]
  translations      ChapterTranslation[]
