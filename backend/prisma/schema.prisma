  userId String @unique @map("user_id") @db.Uuid

  status AuthorApplicationStatus @default(DRAFT)

  penName String? @map("pen_name") @db.VarChar(40)

  fullName String? @map("full_name") @db.VarChar(80)

  email String? @db.VarChar(320)

  phone String? @db.VarChar(30)

  portfolioUrl String? @map("portfolio_url") @db.VarChar(500)

  primaryGenre String? @map("primary_genre") @db.VarChar(80)

  experience String? @db.VarChar(50)

  introduction String? @db.Text

  firstWorkSynopsis String? @map("first_work_synopsis") @db.Text

  acceptedTerms Boolean @default(false) @map("accepted_terms")

  sampleMediaId String? @unique @map("sample_media_id") @db.Uuid

  submittedAt DateTime? @map("submitted_at") @db.Timestamptz(3)

  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(3)

  reviewedById String? @map("reviewed_by_id") @db.Uuid

  rejectionReason String? @map("rejection_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

