  @@id([storyId, tagId])
  @@index([tagId, storyId])
  @@map("story_tags")
}

model Chapter {
  id                    String        @id @default(uuid()) @db.Uuid
  storyId               String        @map("story_id") @db.Uuid
  createdById           String        @map("created_by_id") @db.Uuid
  updatedById           String        @map("updated_by_id") @db.Uuid
  number                Decimal       @db.Decimal(10, 2)
