{"uid":"qlt-infra","title":"Infrastructure","schemaVersion":41,"refresh":"15s","panels":[{"type":"stat","title":"Dependency health","targets":[{"expr":"qlt_dependency_health"}]},{"type":"timeseries","title":"Redis errors","targets":[{"expr":"rate(qlt_redis_errors_total[5m])"}]},{"type":"timeseries","title":"Cache operations","targets":[{"expr":"sum by (result) (rate(qlt_cache_operations_total[5m]))"}]},{"type":"timeseries","title":"Lock contention","targets":[{"expr":"rate(qlt_distributed_lock_operations_total{result=~\"conflict|failed\"}[5m])"}]},{"type":"timeseries","title":"Idempotency","targets":[{"expr":"sum by (result) (rate(qlt_idempotency_operations_total[5m]))"}]},{"type":"timeseries","title":"Webhook backlog","targets":[{"expr":"qlt_cloudinary_webhook_backlog_events"}]}]}
