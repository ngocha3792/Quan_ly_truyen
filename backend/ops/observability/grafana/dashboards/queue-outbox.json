{
  "uid": "qlt-queue",
  "title": "Queue and Outbox",
  "schemaVersion": 41,
  "refresh": "15s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Outbox backlog",
      "targets": [{ "expr": "qlt_outbox_backlog_events" }]
    },
    {
      "type": "stat",
      "title": "Oldest pending outbox",
      "targets": [{ "expr": "qlt_outbox_oldest_pending_age_seconds" }]
    },
    {
      "type": "timeseries",
      "title": "Outbox outcomes",
      "targets": [
        { "expr": "sum by (result) (rate(qlt_outbox_events_total[5m]))" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Queue jobs",
      "targets": [{ "expr": "qlt_queue_jobs" }]
    },
    {
      "type": "stat",
      "title": "Workers",
      "targets": [{ "expr": "qlt_queue_workers" }]
    },
    {
      "type": "timeseries",
      "title": "Mail outcomes",
      "targets": [
        { "expr": "sum by (result) (rate(qlt_mail_deliveries_total[5m]))" }
      ]
    }
  ]
}
