{
  "schemaVersion": 1,
  "release": "production-v1",
  "policy": {
    "requiredFeaturesMustBeReadyForProduction": true,
    "deferredFeaturesMustBeHidden": true
  },
  "features": [
    {
      "id": "account-auth-security",
      "decision": "required",
      "readiness": "ready",
      "productionExposure": "enabled",
      "owner": "backend/auth + frontend/account",
      "notes": "Register, login, refresh, logout, verification, reset/change password, sessions, MFA and account security are in V1."
    },
    {
      "id": "reader-catalog-and-reading",
      "decision": "required",
      "readiness": "ready",
      "productionExposure": "enabled",
      "owner": "backend/stories+chapters + frontend/public",
      "notes": "Public catalog, story detail and chapter reading are in V1."
    },
    {
      "id": "reader-history-and-progress",
      "decision": "required",
      "readiness": "ready",
      "productionExposure": "enabled",
      "owner": "backend/reading-history + frontend/account",
      "notes": "Cross-session reading history and progress are in V1."
    },
    {
      "id": "reader-bookmarks",
      "decision": "required",
      "readiness": "ready",
      "productionExposure": "enabled",
      "owner": "backend/reading-history + frontend/reader",
      "notes": "Chapter bookmarks are persisted through application ports and Prisma, loaded on reader/history views, and verified across independent user sessions."
    },
    {
      "id": "reader-library",
      "decision": "required",
      "readiness": "ready",
      "productionExposure": "enabled",
      "owner": "backend/libraries + frontend/account",
      "notes": "Reader library is in V1."
    },
    {
      "id": "reader-comments-ratings-reports",
      "decision": "required",
      "readiness": "ready",
      "productionExposure": "enabled",
      "owner": "backend/comments+ratings+reports + frontend/public",
      "notes": "Comments, reactions, ratings and reader reporting are in V1."
    },
    {
      "id": "author-follow",
      "decision": "required",
      "readiness": "ready",
      "productionExposure": "enabled",
      "owner": "backend/follows + frontend/account+public",
      "notes": "Following authors is in V1 alongside the separate story-follow capability."
    },
    {
      "id": "notifications",
      "decision": "required",
      "readiness": "ready",
      "productionExposure": "enabled",
      "owner": "backend/notifications + frontend/account",
      "notes": "Notification flows include deduplicated new-chapter fanout and explicit per-channel opt-in weekly reading recaps. Recap email uses the encrypted outbox and recorded ReadingSession totals only."
    },
    {
      "id": "author-application",
      "decision": "required",
      "readiness": "ready",
      "productionExposure": "enabled",
      "owner": "backend/author-applications + frontend/account",
      "notes": "Author application and admin approval/rejection are in V1."
    },
    {
      "id": "author-story-management",
      "decision": "required",
      "readiness": "ready",
      "productionExposure": "enabled",
      "owner": "backend/stories + frontend/author-portal",
      "notes": "Author story lifecycle and immediate chapter publishing are in V1."
    },
    {
      "id": "production-media",
      "decision": "required",
      "readiness": "ready",
      "productionExposure": "enabled",
      "owner": "backend/media + frontend upload flows + production config",
      "notes": "Cloudinary upload, confirmation, webhook and cleanup flows are implemented. Production validation requires CLOUDINARY_ENABLED=true and valid credentials."
    },
    {
      "id": "admin-operations",
      "decision": "required",
      "readiness": "ready",
      "productionExposure": "enabled",
      "owner": "backend/admin-facing modules + frontend/admin",
      "notes": "User administration, story review, reports/moderation, taxonomy and audit-log read-side are in V1."
    },
    {
      "id": "public-content-review",
      "decision": "required",
      "readiness": "ready",
      "productionExposure": "enabled",
      "owner": "frontend/public/static + product/legal",
      "notes": "Current public static content is accepted for the automated production release baseline."
    },
    {
      "id": "story-follow",
      "decision": "required",
      "readiness": "ready",
      "productionExposure": "enabled",
      "owner": "backend/follows + frontend/public",
      "notes": "Readers can follow individual stories and receive deduplicated new-chapter notifications."
    },
    {
      "id": "chapter-scheduling",
      "decision": "required",
      "readiness": "ready",
      "productionExposure": "enabled",
      "owner": "backend/chapters + worker + frontend/author-studio",
      "notes": "Authors can schedule, reschedule, cancel or publish early. The worker recovers due chapters and emits publication side effects only after the durable publish transition."
    },
    {
      "id": "reader-weekly-reading-time",
      "decision": "required",
      "readiness": "ready",
      "productionExposure": "enabled",
      "owner": "backend/reading-history + frontend/account",
      "notes": "Readers receive weekly active-reading totals and streaks derived from persisted ReadingSession rows; missing activity is not replaced by synthetic progress."
    },
    {
      "id": "story-contributor-workflow",
      "decision": "required",
      "readiness": "ready",
      "productionExposure": "enabled",
      "owner": "backend/stories + frontend/author-portal",
      "notes": "Story owners can add, update and remove contributors by account email, role and edit permission."
    },
    {
      "id": "chapter-version-history",
      "decision": "required",
      "readiness": "ready",
      "productionExposure": "enabled",
      "owner": "backend/chapters + frontend/author-portal",
      "notes": "Authors can inspect immutable chapter revisions and restore a selected version through the versioned chapter workflow."
    },
    {
      "id": "explainable-story-recommendations",
      "decision": "required",
      "readiness": "ready",
      "productionExposure": "enabled",
      "owner": "backend/stories + frontend/public",
      "notes": "Story discovery uses deterministic category, follow and rating signals with user-visible reasons. It does not claim behavioral ML personalization."
    },
    {
      "id": "truthful-author-analytics",
      "decision": "required",
      "readiness": "ready",
      "productionExposure": "enabled",
      "owner": "backend/analytics + worker + frontend/author-portal",
      "notes": "Author dashboards expose recorded daily aggregates, source coverage and freshness. Missing dates are not zero-filled and synthetic trends remain prohibited."
    },
    {
      "id": "monetization-wallet-paywall",
      "decision": "deferred",
      "readiness": "deferred",
      "productionExposure": "hidden",
      "owner": "backend/wallets + planned billing/monetization + frontend/account",
      "nextPhase": "post-v1",
      "notes": "Sprint 1 wallet and immutable ledger foundation exists behind MONETIZATION_ENABLED=false. Payment order creation, chapter pricing, entitlement gating and production rollout are not ready."
    },
    {
      "id": "personalized-recommendations",
      "decision": "deferred",
      "readiness": "deferred",
      "productionExposure": "hidden",
      "owner": "planned discovery",
      "nextPhase": "post-v1",
      "notes": "Ranking/filtering is allowed; claims of personalized recommendation are not."
    },
    {
      "id": "author-dashboard-advanced-goals-and-trends",
      "decision": "deferred",
      "readiness": "deferred",
      "productionExposure": "hidden",
      "owner": "planned author analytics",
      "nextPhase": "post-v1",
      "notes": "Synthetic metric trends, gamified author level/XP and fake comment unread state are not exposed. Monthly goals remain deferred and hidden until backed by persisted product semantics."
    }
  ],
  "sourceGuards": [
    {
      "featureId": "monetization-wallet-paywall",
      "path": "backend/src/config/monetization.config.ts",
      "forbidden": ["enabled: process.env.MONETIZATION_ENABLED !== 'false'"]
    },
    {
      "featureId": "personalized-recommendations",
      "path": "frontend/src/app/features/public/static/pages/about-page/about-page.component.html",
      "forbidden": ["gợi ý cá nhân hóa"]
    },
    {
      "featureId": "author-dashboard-advanced-goals-and-trends",
      "path": "frontend/src/app/features/author-portal/author-studio",
      "forbidden": [
        "metric.trendDirection",
        "metric.trendValue",
        "metric.trendLabel"
      ]
    },
    {
      "featureId": "author-dashboard-advanced-goals-and-trends",
      "path": "frontend/src/app/features/author-portal/author-studio/ui/dashboard-bottom-panels/dashboard-bottom-panels.component.ts",
      "forbidden": ["Mục tiêu tháng này", "monthlyGoals"]
    }
  ]
}
