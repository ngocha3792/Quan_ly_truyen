# Run from the backend directory. Replace /srv/quan-ly-truyen/backend.
# Use flock so jobs never overlap.

# Daily maintenance
0 2 * * * cd /srv/quan-ly-truyen/backend && flock -n /var/lock/qlt-maintenance.lock pwsh -NoProfile -File ./ops/production/Invoke-Maintenance.ps1 >> /var/log/qlt-maintenance.log 2>&1

# Daily local + encrypted off-host backup
0 3 * * * cd /srv/quan-ly-truyen/backend && flock -n /var/lock/qlt-backup.lock pwsh -NoProfile -File ./ops/production/Backup-Postgres.ps1 >> /var/log/qlt-backup.log 2>&1

# Full off-host restore drill every Sunday
0 4 * * 0 cd /srv/quan-ly-truyen/backend && flock -n /var/lock/qlt-restore-drill.lock pwsh -NoProfile -File ./ops/production/Test-PostgresRestoreDrill.ps1 >> /var/log/qlt-restore-drill.log 2>&1
