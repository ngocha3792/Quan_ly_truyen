# Run from the backend directory. Replace /srv/quan-ly-truyen/backend.
# Use flock so jobs never overlap.

0 2 * * * cd /srv/quan-ly-truyen/backend && flock -n /var/lock/qlt-maintenance.lock docker compose --env-file .env.production -f compose.production.yml --profile maintenance run --rm auth-cleanup && docker compose --env-file .env.production -f compose.production.yml --profile maintenance run --rm outbox-cleanup && docker compose --env-file .env.production -f compose.production.yml --profile maintenance run --rm mail-queue-cleanup >> /var/log/qlt-maintenance.log 2>&1

0 3 * * * cd /srv/quan-ly-truyen/backend && flock -n /var/lock/qlt-backup.lock docker compose --env-file .env.production -f compose.production.yml --profile maintenance run --rm backup-postgres >> /var/log/qlt-backup.log 2>&1
