# Safe placeholders used only by `docker compose config` in CI/local validation.
# This file is intentionally NOT a deployable production environment.
PRODUCTION_ENV_FILE=ops/production/compose.validation.env.example
COMPOSE_PROJECT_NAME=quan-ly-truyen-production-validation
DEPLOYMENT_ENVIRONMENT=production
RELEASE_SHA=0123456789abcdef0123456789abcdef01234567

OBSERVABILITY_COMPOSE_PROJECT_NAME=quan-ly-truyen-production-observability-validation
OBSERVABILITY_BACKEND_NETWORK=quan-ly-truyen-production-validation-backend
ALERTMANAGER_HOST_PORT=9093
PROMETHEUS_HOST_PORT=9090
LOKI_HOST_PORT=3100
TEMPO_HOST_PORT=3200
ALLOY_HOST_PORT=12345
GRAFANA_HOST_PORT=3001

POSTGRES_IMAGE=postgres:validation
REDIS_IMAGE=redis:validation
CADDY_IMAGE=caddy:validation
RESTIC_IMAGE=restic/restic:validation
ALERTMANAGER_IMAGE=prom/alertmanager:validation

BACKEND_IMAGE_NAME=example.invalid/quan-ly-truyen-backend
BACKEND_IMAGE_TAG=0123456789abcdef0123456789abcdef01234567
FRONTEND_IMAGE_NAME=example.invalid/quan-ly-truyen-frontend
FRONTEND_IMAGE_TAG=0123456789abcdef0123456789abcdef01234567

POSTGRES_DB=quan_ly_truyen_validation
POSTGRES_USER=qlt_validation
POSTGRES_PASSWORD=validation-only-not-a-secret
REDIS_PASSWORD=validation-only-not-a-secret
APP_DOMAIN=validation.example
APP_PUBLIC_URL=https://validation.example
GRAFANA_ADMIN_USER=validation
GRAFANA_ADMIN_PASSWORD=validation-only-not-a-secret
