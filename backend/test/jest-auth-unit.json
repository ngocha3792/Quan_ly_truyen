{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testMatch": ["<rootDir>/src/modules/auth/**/*.spec.ts"],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1",
    "^(\\.\\.?/.*)\\.js$": "$1"
  },
  "collectCoverageFrom": [
    "<rootDir>/src/modules/auth/application/**/*.ts",
    "!<rootDir>/src/modules/auth/application/**/index.ts",
    "!<rootDir>/src/modules/auth/application/**/*.interface.ts",
    "!<rootDir>/src/modules/auth/application/**/*.type.ts"
  ],
  "coverageDirectory": "<rootDir>/coverage/auth",
  "coverageReporters": ["text", "json-summary", "lcov"],
  "coverageThreshold": {
    "global": {
      "branches": 47,
      "functions": 53,
      "lines": 67,
      "statements": 69
    }
  }
}
