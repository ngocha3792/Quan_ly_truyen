{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "clearMocks": true,
  "restoreMocks": true,
  "testTimeout": 60000,
  "maxWorkers": 1,
  "detectOpenHandles": true,
  "setupFiles": ["<rootDir>/setup/setup-e2e-env.ts"],
  "testRegex": "author-profile-follow-notifications\\.integration-spec\\.ts$",
  "transform": { "^.+\\.(t|j)s$": "ts-jest" },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/../src/$1",
    "^(\\.\\.?/.*)\\.js$": "$1"
  }
}
