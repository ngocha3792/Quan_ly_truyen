{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testTimeout": 30000,
  "maxWorkers": 1,
  "detectOpenHandles": true,
  "setupFiles": ["<rootDir>/setup/setup-e2e-env.ts"],
  "testRegex": "stories(?:-workflow)?\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/../src/$1",
    "^(\\.\\.?/.*)\\.js$": "$1"
  }
}
