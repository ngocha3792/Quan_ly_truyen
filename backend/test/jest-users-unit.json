{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testMatch": [
    "<rootDir>/src/modules/users/application/commands/**/*.spec.ts",
    "<rootDir>/src/modules/users/domain/policies/**/*.spec.ts"
  ],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1",
    "^(\\.\\.?/.*)\\.js$": "$1"
  },
  "collectCoverageFrom": [
    "<rootDir>/src/modules/users/application/commands/**/*.command-handler.ts",
    "<rootDir>/src/modules/users/domain/policies/**/*.ts",
    "!<rootDir>/src/modules/users/**/index.ts"
  ],
  "coverageDirectory": "<rootDir>/coverage/users",
  "coverageReporters": ["text", "json-summary", "lcov"],
  "coverageThreshold": {
    "global": {
      "branches": 65,
      "functions": 80,
      "lines": 80,
      "statements": 80
    }
  }
}