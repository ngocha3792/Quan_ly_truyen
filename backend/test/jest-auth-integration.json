{
    "moduleFileExtensions": [
        "js",
        "json",
        "ts"
    ],
    "rootDir": ".",
    "testEnvironment": "node",
    "testTimeout": 60000,
    "maxWorkers": 1,
    "detectOpenHandles": true,
    "setupFiles": [
        "<rootDir>/setup/setup-auth-integration-env.ts"
    ],
    "testRegex": "auth-.*\\.integration-spec\\.ts$",
    "transform": {
        "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
        "^@/(.*)$": "<rootDir>/../src/$1",
        "^(\\.\\.?/.*)\\.js$": "$1"
    }
}