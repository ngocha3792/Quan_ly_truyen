name: quan-ly-truyen-production

x-default-logging: &default-logging
  driver: json-file
  options:
    max-size: "10m"
    max-file: "5"

x-runtime-common: &runtime-common
  image: ${BACKEND_IMAGE_NAME:?BACKEND_IMAGE_NAME is required}:${BACKEND_IMAGE_TAG:?BACKEND_IMAGE_TAG must be an immutable Git SHA or release tag}
  env_file:
    - ${PRODUCTION_ENV_FILE:-.env.production}
  restart: unless-stopped
  networks:
    - backend
  read_only: true
  tmpfs:
    - /tmp:size=64m,mode=1777
  cap_drop:
    - ALL
  security_opt:
    - no-new-privileges:true
  pids_limit: 256
  ulimits:
    nofile:
      soft: 65536
      hard: 65536
  logging: *default-logging

x-tool-common: &tool-common
  image: ${BACKEND_IMAGE_NAME:?BACKEND_IMAGE_NAME is required}-migrate:${BACKEND_IMAGE_TAG:?BACKEND_IMAGE_TAG is required}
  env_file:
    - ${PRODUCTION_ENV_FILE:-.env.production}
  restart: "no"
  networks:
    - backend
  read_only: true
  tmpfs:
    - /tmp:size=64m,mode=1777
  cap_drop:
    - ALL
  security_opt:
    - no-new-privileges:true
  pids_limit: 256
  logging: *default-logging

services:
  postgres:
    image: ${POSTGRES_IMAGE:-postgres:17.10-alpine3.23}
    restart: unless-stopped
    environment:
      POSTGRES_DB: ${POSTGRES_DB:?POSTGRES_DB is required}
      POSTGRES_USER: ${POSTGRES_USER:?POSTGRES_USER is required}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?POSTGRES_PASSWORD is required}
    volumes:
      - postgres-production-data:/var/lib/postgresql/data
    networks:
      - backend
    healthcheck:
      test:
        [
          "CMD-SHELL",
          "pg_isready -U \"$${POSTGRES_USER}\" -d \"$${POSTGRES_DB}\""
        ]
      interval: 10s
      timeout: 5s
      retries: 20
      start_period: 20s
    stop_grace_period: 60s
    shm_size: ${POSTGRES_SHM_SIZE:-256m}
    mem_limit: ${POSTGRES_MEMORY_LIMIT:-1536m}
    cpus: ${POSTGRES_CPU_LIMIT:-1.50}
    pids_limit: 256
    logging: *default-logging

  redis:
    image: ${REDIS_IMAGE:-redis:7.4.10-alpine3.21}
    restart: unless-stopped
    environment:
      REDIS_PASSWORD: ${REDIS_PASSWORD:?REDIS_PASSWORD is required}
    command:
      - redis-server
      - --appendonly
      - "yes"
      - --appendfsync
      - everysec
      - --requirepass
      - ${REDIS_PASSWORD:?REDIS_PASSWORD is required}
      - --maxmemory-policy
      - noeviction
    volumes:
      - redis-production-data:/data
    networks:
      - backend
    healthcheck:
      test:
        [
          "CMD-SHELL",
          "redis-cli -a \"$${REDIS_PASSWORD}\" --no-auth-warning ping | grep PONG"
        ]
      interval: 10s
      timeout: 5s
      retries: 20
      start_period: 10s
    stop_grace_period: 30s
    mem_limit: ${REDIS_MEMORY_LIMIT:-512m}
    cpus: ${REDIS_CPU_LIMIT:-0.75}
    pids_limit: 128
    logging: *default-logging

  migrate:
    <<: *tool-common
    command:
      - npm
      - run
      - db:migrate:deploy
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy

  seed:
    <<: *tool-common
    profiles:
      - tools
    command:
      - npm
      - run
      - db:seed
    depends_on:
      migrate:
        condition: service_completed_successfully

  api:
    <<: *runtime-common
    command:
      - node
      - dist/main.js
    expose:
      - "3000"
    depends_on:
      migrate:
        condition: service_completed_successfully
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    healthcheck:
      test:
        [
          "CMD",
          "node",
          "-e",
          "fetch('http://127.0.0.1:3000/api/v1/health/ready').then(response => { if (!response.ok) process.exit(1); }).catch(() => process.exit(1));"
        ]
      interval: 15s
      timeout: 5s
      retries: 20
      start_period: 60s
    stop_grace_period: 30s
    mem_limit: ${API_MEMORY_LIMIT:-768m}
    cpus: ${API_CPU_LIMIT:-1.00}

  worker:
    <<: *runtime-common
    command:
      - node
      - dist/worker.js
    depends_on:
      migrate:
        condition: service_completed_successfully
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    healthcheck:
      test:
        [
          "CMD",
          "node",
          "dist/healthcheck/worker-heartbeat.healthcheck.js"
        ]
      interval: 15s
      timeout: 8s
      retries: 10
      start_period: 45s
    stop_grace_period: 60s
    mem_limit: ${WORKER_MEMORY_LIMIT:-768m}
    cpus: ${WORKER_CPU_LIMIT:-1.00}

  caddy:
    image: ${CADDY_IMAGE:-caddy:2.11.4-alpine}
    restart: unless-stopped
    env_file:
      - ${PRODUCTION_ENV_FILE:-.env.production}
    ports:
      - "80:80"
      - "443:443"
      - "443:443/udp"
    volumes:
      - ./ops/production/Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy-production-data:/data
      - caddy-production-config:/config
    networks:
      - backend
    depends_on:
      api:
        condition: service_healthy
    read_only: true
    tmpfs:
      - /tmp:size=32m,mode=1777
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
    security_opt:
      - no-new-privileges:true
    pids_limit: 128
    mem_limit: ${CADDY_MEMORY_LIMIT:-256m}
    cpus: ${CADDY_CPU_LIMIT:-0.50}
    healthcheck:
      test:
        - CMD-SHELL
        - caddy version >/dev/null 2>&1 || exit 1
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 15s
    interval: 10s
    timeout: 5s
    retries: 10
    start_period: 15s
    logging: *default-logging

  gate-predeploy:
    <<: *tool-common
    profiles:
      - tools
    command:
      - npm
      - run
      - production:gate:predeploy
    depends_on:
      migrate:
        condition: service_completed_successfully
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy

  gate-postdeploy:
    <<: *tool-common
    profiles:
      - tools
    command:
      - npm
      - run
      - production:gate:postdeploy
    depends_on:
      api:
        condition: service_healthy
      worker:
        condition: service_healthy

  auth-cleanup:
    <<: *tool-common
    profiles:
      - maintenance
    command:
      - npm
      - run
      - maintenance:auth-cleanup
      - --
      - --apply
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy

  outbox-cleanup:
    <<: *tool-common
    profiles:
      - maintenance
    command:
      - npm
      - run
      - maintenance:outbox-cleanup
      - --
      - --apply
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy

  mail-queue-cleanup:
    <<: *tool-common
    profiles:
      - maintenance
    command:
      - npm
      - run
      - maintenance:mail-queue-cleanup
      - --
      - --apply
    depends_on:
      redis:
        condition: service_healthy

  backup-postgres:
    image: ${POSTGRES_IMAGE:-postgres:17.10-alpine3.23}
    profiles:
      - maintenance
    restart: "no"
    environment:
      POSTGRES_DB: ${POSTGRES_DB:?POSTGRES_DB is required}
      POSTGRES_USER: ${POSTGRES_USER:?POSTGRES_USER is required}
      PGPASSWORD: ${POSTGRES_PASSWORD:?POSTGRES_PASSWORD is required}
      BACKUP_RETENTION_DAYS: ${BACKUP_RETENTION_DAYS:-14}
    command:
      - sh
      - -ec
      - |
        umask 077
        timestamp="$$(date -u +%Y%m%dT%H%M%SZ)"
        dump="/backups/quan_ly_truyen-$${timestamp}.dump"
        pg_dump \
          --host=postgres \
          --username="$${POSTGRES_USER}" \
          --dbname="$${POSTGRES_DB}" \
          --format=custom \
          --compress=9 \
          --file="$${dump}"
        pg_restore --list "$${dump}" >/dev/null
        sha256sum "$${dump}" > "$${dump}.sha256"
        find /backups -type f -mtime "+$${BACKUP_RETENTION_DAYS}" -delete
        echo "Backup completed: $${dump}"
    volumes:
      - ${POSTGRES_BACKUP_DIRECTORY:-./backups}:/backups
    networks:
      - backend
    depends_on:
      postgres:
        condition: service_healthy
    read_only: true
    tmpfs:
      - /tmp:size=64m,mode=1777
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    pids_limit: 128
    mem_limit: ${BACKUP_MEMORY_LIMIT:-512m}
    cpus: ${BACKUP_CPU_LIMIT:-0.75}
    logging: *default-logging

networks:
  backend:
    name: quan-ly-truyen-production-backend
    driver: bridge

volumes:
  postgres-production-data:
  redis-production-data:
  caddy-production-data:
  caddy-production-config:
