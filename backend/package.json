{
  "name": "backend",
  "version": "0.0.1",
  "type": "commonjs",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "env:check": "node ../scripts/check-development-environment.mjs",
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "start:worker:prod": "node dist/worker.js",
    "start:worker:dev": "nest start --entryFile worker --watch",
    "lint": "eslint \"{src,scripts,test}/**/*.ts\" --fix",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "test": "jest",
    "test:author-applications:prepare": "node -r ts-node/register -r tsconfig-paths/register scripts/testing/prepare-postgres-test-environment.ts",
    "test:author-applications:integration": "npm run test:author-applications:prepare && jest --config ./test/jest-author-applications-integration.json --runInBand",
    "test:stories:prepare": "node -r ts-node/register -r tsconfig-paths/register scripts/testing/prepare-postgres-test-environment.ts",
    "test:stories:integration": "npm run test:stories:prepare && jest --config ./test/jest-stories-integration.json --runInBand",
    "test:stories:e2e": "npm run test:stories:prepare && jest --config ./test/jest-stories-e2e.json --runInBand",
    "test:stories:all": "npm run test:stories:integration && npm run test:stories:e2e",
    "test:users:prepare": "node -r ts-node/register -r tsconfig-paths/register scripts/testing/prepare-postgres-test-environment.ts",
    "test:users:integration": "npm run test:users:prepare && jest --config ./test/jest-users-integration.json --runInBand",
    "test:phase4": "npm run test:auth:unit && npm run test:users:integration && npm run test:author-applications:integration && npm run test:auth:integration",
    "test:smoke:auth:production": "powershell -ExecutionPolicy Bypass -File ./scripts/smoke-auth-production.ps1",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "npm run test:e2e:prepare && jest --config ./test/jest-e2e.json --runInBand",
    "test:auth:unit": "jest --config ./test/jest-auth-unit.json --runInBand",
    "test:auth:prepare": "node -r ts-node/register -r tsconfig-paths/register scripts/testing/prepare-auth-test-environment.ts",
    "test:auth:integration": "npm run test:auth:prepare && jest --config ./test/jest-auth-integration.json --runInBand",
    "test:auth:e2e": "npm run test:auth:prepare && jest --config ./test/jest-auth-e2e.json --runInBand",
    "test:auth:all": "npm run test:auth:unit && npm run test:auth:integration && npm run test:auth:e2e",
    "ci:unit": "npm run lint:check && npm run typecheck:scripts && npm run build && npm test -- --runInBand",
    "ci:integration": "npm run test:users:integration && npm run test:author-applications:integration && npm run test:auth:integration && npm run test:auth:e2e && npm run test:stories:integration && npm run test:authors-phase5:integration && npm run test:taxonomy:integration && npm run test:comments:integration && npm run test:e2e && npm run test:audit:integration && npm run test:analytics:integration",
    "quality:check": "npm run format:check && npm run lint:check && npm run typecheck:scripts && npm run architecture:check && npm run db:validate && npm run build && npm test -- --runInBand",
    "ci": "npm run env:check && npm run quality:check",
    "postinstall": "prisma generate --config prisma.config.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:e2e": "tsx prisma/seed-e2e.ts",
    "db:seed:e2e:stories": "tsx prisma/seed-e2e-stories.ts",
    "db:seed:e2e:admin": "tsx prisma/seed-e2e-admin.ts",
    "db:reset:local": "tsx scripts/database/reset-local-database.ts",
    "db:check": "tsx scripts/database/check-connection.ts",
    "db:validate:schema": "prisma validate --config prisma.config.ts",
    "db:validate:migrations": "node -r ts-node/register scripts/database/validate-migration-layout.ts",
    "db:validate": "npm run db:validate:schema && npm run db:validate:migrations",
    "db:migrate:status": "prisma migrate status --config prisma.config.ts",
    "db:verify:constraints": "tsx scripts/database/verify-manual-constraints.ts",
    "db:verify:seed": "tsx scripts/database/verify-seed-data.ts",
    "ci:check-env": "tsx scripts/ci/check-environment.ts",
    "ci:wait-db": "tsx scripts/ci/wait-for-postgres.ts",
    "admin:create": "tsx scripts/development/create-admin.ts",
    "maintenance:auth-cleanup": "node -r reflect-metadata -r ts-node/register -r tsconfig-paths/register scripts/maintenance/cleanup-expired-auth-records.ts",
    "maintenance:outbox-cleanup": "node -r reflect-metadata -r ts-node/register -r tsconfig-paths/register scripts/maintenance/cleanup-outbox-events.ts",
    "maintenance:mail-queue-cleanup": "tsx scripts/maintenance/cleanup-mail-queue-jobs.ts",
    "maintenance:story-counters": "tsx scripts/maintenance/reconcile-story-counters.ts",
    "maintenance:media-cleanup": "node -r reflect-metadata -r ts-node/register -r tsconfig-paths/register scripts/maintenance/cleanup-expired-media.ts",
    "maintenance:cloudinary-webhooks": "node -r reflect-metadata -r ts-node/register -r tsconfig-paths/register scripts/maintenance/process-cloudinary-webhooks.ts",
    "observability:smoke": "tsx scripts/observability/smoke-test.ts",
    "ci:verify-cloudinary": "tsx scripts/ci/verify-cloudinary-config.ts",
    "db:migrate": "prisma migrate dev --config prisma.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "production:gate:predeploy": "tsx scripts/ci/production-gate.ts --phase=predeploy",
    "production:gate:postdeploy": "tsx scripts/ci/production-gate.ts --phase=postdeploy",
    "ci:production-source": "npm run ci:check-env && npm run build && npm run typecheck:scripts && npm test -- --runInBand && npm run test:auth:integration && npm run test:auth:e2e",
    "docker:dev": "docker compose -f docker/compose.dev.yml up --build",
    "docker:dev:detached": "docker compose -f docker/compose.dev.yml up --build -d",
    "docker:dev:down": "docker compose -f docker/compose.dev.yml down --remove-orphans",
    "docker:dev:reset": "docker compose -f docker/compose.dev.yml down -v --remove-orphans",
    "docker:dev:logs": "docker compose -f docker/compose.dev.yml logs -f api worker",
    "docker:dev:ps": "docker compose -f docker/compose.dev.yml ps",
    "docker:test:auth": "docker compose -f docker/compose.dev.yml --profile test run --build --rm auth-tests",
    "docker:prod:config": "docker compose --env-file .env.production -f compose.production.yml config --services",
    "docker:prod:build:no-cache": "docker compose --env-file .env.production -f compose.production.yml -f compose.production.build.yml build --no-cache",
    "docker:prod:down": "docker compose --env-file .env.production -f compose.production.yml down --remove-orphans",
    "docker:prod:ps": "docker compose --env-file .env.production -f compose.production.yml ps -a",
    "docker:prod:logs": "docker compose --env-file .env.production -f compose.production.yml logs -f api worker recovery-metrics frontend caddy",
    "docker:prod:migrate": "docker compose --env-file .env.production -f compose.production.yml run --rm migrate",
    "docker:prod:seed": "docker compose --env-file .env.production -f compose.production.yml --profile tools run --rm seed",
    "lint:check": "eslint \"{src,scripts,test}/**/*.ts\" --max-warnings=0",
    "test:auth:unit:cov": "jest --config ./test/jest-auth-unit.json --runInBand --coverage",
    "test:users:unit:cov": "jest --config ./test/jest-users-unit.json --runInBand --coverage",
    "test:author-applications:unit:cov": "jest --config ./test/jest-author-applications-unit.json --runInBand --coverage",
    "test:critical:unit:cov": "npm run test:auth:unit:cov && npm run test:users:unit:cov && npm run test:author-applications:unit:cov",
    "ci:auth": "npm run ci:check-env && npm run lint:check && npm run build && npm run typecheck:scripts && npm run test:auth:unit:cov && npm run test:auth:integration && npm run test:auth:e2e",
    "docker:prod:build": "docker compose --env-file .env.production -f compose.production.yml -f compose.production.build.yml build",
    "docker:prod:up": "powershell -NoProfile -ExecutionPolicy Bypass -File ops/production/Deploy-Production.ps1",
    "docker:prod:up:local": "docker compose --env-file .env.production -f compose.production.yml -f compose.production.build.yml up --build -d --wait",
    "docker:prod:pull": "docker compose --env-file .env.production -f compose.production.yml pull",
    "docker:prod:maintenance": "powershell -NoProfile -ExecutionPolicy Bypass -File ops/production/Invoke-Maintenance.ps1",
    "docker:prod:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File ops/production/Backup-Postgres.ps1",
    "docker:prod:restore-drill": "powershell -NoProfile -ExecutionPolicy Bypass -File ops/production/Test-PostgresRestoreDrill.ps1",
    "docker:prod:gate:predeploy": "docker compose --env-file .env.production -f compose.production.yml --profile tools run --rm gate-predeploy",
    "docker:prod:gate:postdeploy": "docker compose --env-file .env.production -f compose.production.yml --profile tools run --rm gate-postdeploy",
    "observability:up": "docker compose --env-file .env.production -f ops/observability/docker-compose.observability.yml up -d",
    "observability:down": "docker compose --env-file .env.production -f ops/observability/docker-compose.observability.yml down",
    "observability:config": "docker compose --env-file .env.production -f ops/observability/docker-compose.observability.yml config",
    "db:seed:e2e:all": "npm run db:seed && npm run db:seed:e2e && npm run db:seed:e2e:admin && npm run db:seed:e2e:stories",
    "test:e2e:prepare": "node -r ts-node/register -r tsconfig-paths/register scripts/testing/prepare-postgres-test-environment.ts",
    "ci:deployment-isolation": "node scripts/ci/validate-deployment-isolation.mjs",
    "docker:prod:config:example": "docker compose --env-file ops/production/compose.validation.env.example -f compose.production.yml -f compose.production.build.yml config --quiet",
    "docker:staging:config:example": "docker compose --env-file ops/production/compose.validation.staging.env.example -f compose.production.yml config --quiet",
    "docker:prod:backup:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File ops/production/Test-PostgresBackupArtifact.ps1",
    "docker:prod:recovery-check": "powershell -NoProfile -ExecutionPolicy Bypass -File ops/production/Test-RecoveryReadiness.ps1",
    "observability:logs": "docker compose --env-file .env.production -f ops/observability/docker-compose.observability.yml logs -f prometheus alertmanager loki tempo alloy grafana",
    "observability:config:example": "docker compose --env-file ops/production/compose.validation.env.example -f ops/observability/docker-compose.observability.yml config --quiet",
    "observability:staging:config:example": "docker compose --env-file ops/production/compose.validation.staging.env.example -f ops/observability/docker-compose.observability.yml config --quiet",
    "deployment:release:staging": "powershell -NoProfile -ExecutionPolicy Bypass -File ops/production/Invoke-Release.ps1 -EnvironmentName staging",
    "deployment:release:production": "powershell -NoProfile -ExecutionPolicy Bypass -File ops/production/Invoke-Release.ps1 -EnvironmentName production -DeploymentMode Registry",
    "deployment:rollback:production": "powershell -NoProfile -ExecutionPolicy Bypass -File ops/production/Invoke-Rollback.ps1 -EnvironmentName production",
    "deployment:smoke:staging": "powershell -NoProfile -ExecutionPolicy Bypass -File ops/production/Test-DeploymentSmoke.ps1 -EnvironmentName staging",
    "deployment:smoke:production": "powershell -NoProfile -ExecutionPolicy Bypass -File ops/production/Test-DeploymentSmoke.ps1 -EnvironmentName production",
    "test:taxonomy:prepare": "node -r ts-node/register -r tsconfig-paths/register scripts/testing/prepare-postgres-test-environment.ts",
    "test:taxonomy:integration": "npm run test:taxonomy:prepare && jest --config ./test/jest-taxonomy-integration.json --runInBand",
    "db:taxonomy:preflight": "tsx scripts/database/preflight-taxonomy-names.ts",
    "test:comments:prepare": "node -r ts-node/register -r tsconfig-paths/register scripts/testing/prepare-postgres-test-environment.ts",
    "test:comments:integration": "npm run test:comments:prepare && jest --config ./test/jest-comments-moderation-integration.json --runInBand",
    "test:audit:prepare": "node -r ts-node/register -r tsconfig-paths/register scripts/testing/prepare-postgres-test-environment.ts",
    "test:audit:integration": "npm run test:audit:prepare && jest --config ./test/jest-audit-logs-integration.json --runInBand",
    "maintenance:author-followers": "tsx scripts/maintenance/reconcile-author-follower-counts.ts",
    "test:authors-phase5:prepare": "node -r ts-node/register -r tsconfig-paths/register scripts/testing/prepare-postgres-test-environment.ts",
    "test:authors-phase5:integration": "npm run test:authors-phase5:prepare && jest --config ./test/jest-author-follow-integration.json --runInBand",
    "maintenance:reader-analytics": "tsx scripts/maintenance/reconcile-reader-analytics.ts",
    "maintenance:reader-analytics-backfill": "tsx scripts/maintenance/backfill-reader-analytics.ts",
    "test:analytics:prepare": "node -r ts-node/register -r tsconfig-paths/register scripts/testing/prepare-postgres-test-environment.ts",
    "test:analytics:integration": "npm run test:analytics:prepare && jest --config ./test/jest-reader-analytics-integration.json --runInBand",
    "loadtest:reader-analytics": "tsx scripts/analytics/load-test-reader-analytics.ts",
    "architecture:check": "node scripts/architecture/check-boundaries.mjs",
    "production:scope:check": "node ../scripts/verify-production-scope.mjs --mode=contract",
    "production:scope:release": "node ../scripts/verify-production-scope.mjs --mode=release",
    "api:contract:check": "node ../scripts/verify-api-contracts.mjs"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.1.29",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.29",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.29",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/terminus": "^11.1.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.79.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@prisma/instrumentation": "7.9.1",
    "@types/ioredis": "^4.28.10",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.1.0",
    "bullmq-otel": "2.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.10.0",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "pino": "10.3.1",
    "prom-client": "15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "pino-pretty": "13.1.3",
    "prettier": "^3.4.2",
    "prisma": "^7.9.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.1",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "clearMocks": true,
    "restoreMocks": true,
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^(\\.\\.?/.*)\\.js$": "$1"
    }
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "js-yaml": "5.2.2"
  },
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": "24.15.x",
    "npm": "11.12.x"
  }
}
