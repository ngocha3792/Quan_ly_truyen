import { createPublicKey, randomBytes } from 'node:crypto';

import { Inject, Injectable } from '@nestjs/common';
import { ConfigService } from '@nestjs/config';
import type Redis from 'ioredis';
import { decode, verify, type JwtHeader, type JwtPayload } from 'jsonwebtoken';

import { RoleCode } from '@/common/enums';
import {
  InvalidInputException,
  ServiceUnavailableException,
} from '@/common/exceptions';
import { sha256, timingSafeEqualStrings } from '@/common/utils';
import type { AuthConfig } from '@/config';
import { OAuthProvider } from '@/generated/prisma/client';
import { REDIS_CLIENT } from '@/infrastructure/cache/redis/redis.constants';
import { PrismaService } from '@/infrastructure/database';

import type { LoginResultDto } from '../../application/dto';
import { LoginResultMapper } from '../../application/mappers';
import {
  AUTH_TOKEN_ISSUER_PORT,
  type AuthTokenIssuerPort,
  ID_GENERATOR_PORT,
  type IdGeneratorPort,
  LOGIN_PERSISTENCE_PORT,
  type LoginAccountRecord,
  type LoginPersistencePort,
  SECURE_TOKEN_PORT,
  type SecureTokenPort,
} from '../../application/ports';
import type { LoginClientContext } from '../../application/commands/login/login.command';
import { AuthAccountStatus, AuthAuditAction } from '../../domain/enums';
import {
  AdminMfaRequiredException,
  OAuthAccountLinkingRequiredException,
  OAuthEmailUnavailableException,
  OAuthFlowInvalidException,
  OAuthProviderRequestException,
  OAuthProviderUnavailableException,
} from '../../domain/exceptions';
import { AccountLoginPolicy } from '../../domain/policies';
import { AuthAuditWriterService } from '../audit';
import { RedisAdminMfaChallengeStore } from '../mfa';

interface GoogleJwk extends JsonWebKey {
  kid?: string;
}

interface OAuthStateRecord {
  provider: 'google' | 'github';
  verifier: string;
  nonce?: string;
  expiresAt: string;
  client: LoginClientContext;
}

export interface OAuthAuthorizationResult {
  url: string;
  state: string;
  expiresAt: Date;
}

interface OAuthProfile {
  provider: OAuthProvider;
  providerAccountId: string;
  email: string;
  emailVerified: boolean;
  displayName: string;
  usernameHint: string;
}

@Injectable()
export class OAuthFlowService {
  private readonly config: AuthConfig;
  private googleJwks: { keys: GoogleJwk[]; expiresAt: number } | null = null;

  constructor(
    configService: ConfigService,
    @Inject(REDIS_CLIENT) private readonly redis: Redis | null,
    private readonly prisma: PrismaService,
    private readonly adminMfa: RedisAdminMfaChallengeStore,
    private readonly auditWriter: AuthAuditWriterService,
    @Inject(LOGIN_PERSISTENCE_PORT)
    private readonly loginPersistence: LoginPersistencePort,
    @Inject(AUTH_TOKEN_ISSUER_PORT)
    private readonly tokenIssuer: AuthTokenIssuerPort,
    @Inject(SECURE_TOKEN_PORT)
    private readonly secureToken: SecureTokenPort,
    @Inject(ID_GENERATOR_PORT)
    private readonly idGenerator: IdGeneratorPort,
  ) {
    this.config = configService.getOrThrow<AuthConfig>('auth');
  }

  async createAuthorizationUrl(
    provider: string,
    client: LoginClientContext,
  ): Promise<OAuthAuthorizationResult> {
    const normalized = parseProvider(provider);
    const settings = this.providerSettings(normalized);
    const state = randomBytes(32).toString('base64url');
    const verifier = randomBytes(48).toString('base64url');
    const challenge = Buffer.from(sha256Buffer(verifier)).toString('base64url');
    const nonce =
      normalized === 'google'
        ? randomBytes(24).toString('base64url')
        : undefined;
    const expiresAt = new Date(
      Date.now() + this.config.oauth.stateTtlSeconds * 1000,
    );
    const record: OAuthStateRecord = {
      provider: normalized,
      verifier,
      nonce,
      expiresAt: expiresAt.toISOString(),
      client,
    };
    await this.requireRedis().set(
      this.stateKey(state),
      JSON.stringify(record),
      'EX',
      this.config.oauth.stateTtlSeconds,
      'NX',
    );

    if (normalized === 'google') {
      const query = new URLSearchParams({
        client_id: settings.clientId,
        redirect_uri: settings.callbackUrl,
        response_type: 'code',
        scope: 'openid email profile',
        state,
        nonce: nonce!,
        code_challenge: challenge,
        code_challenge_method: 'S256',
        prompt: 'select_account',
      });
      return {
        url: `https://accounts.google.com/o/oauth2/v2/auth?${query.toString()}`,
        state,
        expiresAt,
      };
    }

    const query = new URLSearchParams({
      client_id: settings.clientId,
      redirect_uri: settings.callbackUrl,
      scope: 'read:user user:email',
      state,
      code_challenge: challenge,
      code_challenge_method: 'S256',
    });
    return {
      url: `https://github.com/login/oauth/authorize?${query.toString()}`,
      state,
      expiresAt,
    };
  }

  async complete(
    provider: string,
    code: string | undefined,
    state: string | undefined,
    browserState: string,
    providerError: string | undefined,
    clientOverride: LoginClientContext,
  ): Promise<LoginResultDto> {
    const normalized = parseProvider(provider);
    const validatedState = validateStateBinding(state, browserState);
    const flow = await this.consumeState(validatedState);
    const expiresAt = Date.parse(flow.expiresAt);

    if (
      flow.provider !== normalized ||
      !Number.isFinite(expiresAt) ||
      expiresAt <= Date.now()
    ) {
      throw new OAuthFlowInvalidException();
    }

    if (providerError?.trim()) {
      throw new OAuthFlowInvalidException(
        'Đăng nhập OAuth đã bị từ chối hoặc hủy bỏ',
      );
    }

    if (!code?.trim()) {
      throw new OAuthFlowInvalidException('Thiếu authorization code');
    }
    const profile =
      normalized === 'google'
        ? await this.googleProfile(code, flow)
        : await this.githubProfile(code, flow);
    if (!profile.emailVerified) {
      throw new OAuthEmailUnavailableException();
    }
    const account = await this.resolveAccount(profile);
    AccountLoginPolicy.assertCanLogin({
      status: account.status,
      deletedAt: account.deletedAt,
      emailVerifiedAt: account.emailVerifiedAt,
    });
    const client = mergeClient(flow.client, clientOverride);

    if (account.roles.includes(RoleCode.ADMIN) && this.adminMfa.isEnabled()) {
      const challenge = await this.adminMfa.create({
        userId: account.id,
        mode: account.mfaEnabled ? 'verify' : 'enroll',
        source: normalized,
        client,
      });
      throw new AdminMfaRequiredException(challenge);
    }

    return this.createSession(account, client, normalized);
  }

  private async googleProfile(
    code: string,
    flow: OAuthStateRecord,
  ): Promise<OAuthProfile> {
    const settings = this.providerSettings('google');
    try {
      const tokenResponse = await fetchJson(
        'https://oauth2.googleapis.com/token',
        {
          method: 'POST',
          headers: { 'content-type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            code,
            client_id: settings.clientId,
            client_secret: settings.clientSecret,
            redirect_uri: settings.callbackUrl,
            grant_type: 'authorization_code',
            code_verifier: flow.verifier,
          }),
        },
      );
      const idToken = stringField(tokenResponse, 'id_token');
      const payload = await this.verifyGoogleIdToken(
        idToken,
        settings.clientId,
      );
      if (payload.nonce !== flow.nonce) {
        throw new OAuthFlowInvalidException('OAuth nonce không hợp lệ');
      }
      return {
        provider: OAuthProvider.GOOGLE,
        providerAccountId: requiredClaim(payload, 'sub'),
        email: requiredClaim(payload, 'email').toLowerCase(),
        emailVerified:
          payload.email_verified === true || payload.email_verified === 'true',
        displayName:
          optionalClaim(payload, 'name') ??
          requiredClaim(payload, 'email').split('@')[0],
        usernameHint: requiredClaim(payload, 'email').split('@')[0],
      };
    } catch (error) {
      if (error instanceof OAuthFlowInvalidException) throw error;
      throw new OAuthProviderRequestException('google', error);
    }
  }

  private async githubProfile(
    code: string,
    flow: OAuthStateRecord,
  ): Promise<OAuthProfile> {
    const settings = this.providerSettings('github');
    try {
      const tokenResponse = await fetchJson(
        'https://github.com/login/oauth/access_token',
        {
          method: 'POST',
          headers: {
            accept: 'application/json',
            'content-type': 'application/x-www-form-urlencoded',
          },
          body: new URLSearchParams({
            client_id: settings.clientId,
            client_secret: settings.clientSecret,
            code,
            redirect_uri: settings.callbackUrl,
            code_verifier: flow.verifier,
          }),
        },
      );
      const accessToken = stringField(tokenResponse, 'access_token');
      const headers = {
        accept: 'application/vnd.github+json',
        authorization: `Bearer ${accessToken}`,
        'x-github-api-version': '2022-11-28',
        'user-agent': 'quan-ly-truyen-api',
      };
      const [user, emails] = await Promise.all([
        fetchJson('https://api.github.com/user', { headers }),
        fetchJson('https://api.github.com/user/emails', { headers }),
      ]);
      if (!isObject(user)) throw new Error('GitHub user profile missing');
      if (!Array.isArray(emails)) throw new Error('GitHub emails missing');
      const verified =
        emails.find(
          (item) =>
            isObject(item) && item.verified === true && item.primary === true,
        ) ?? emails.find((item) => isObject(item) && item.verified === true);
      if (!isObject(verified) || typeof verified.email !== 'string') {
        throw new OAuthEmailUnavailableException();
      }
      const login = stringField(user, 'login');
      return {
        provider: OAuthProvider.GITHUB,
        providerAccountId: String(numberOrStringField(user, 'id')),
        email: verified.email.toLowerCase(),
        emailVerified: true,
        displayName:
          typeof user.name === 'string' && user.name.trim() ? user.name : login,
        usernameHint: login,
      };
    } catch (error) {
      if (error instanceof OAuthEmailUnavailableException) throw error;
      throw new OAuthProviderRequestException('github', error);
    }
  }

  private async verifyGoogleIdToken(
    token: string,
    audience: string,
  ): Promise<JwtPayload> {
    const decoded = decode(token, { complete: true });
    if (!decoded || typeof decoded === 'string') {
      throw new OAuthFlowInvalidException('Google ID token không hợp lệ');
    }
    const header = decoded.header;
    if (!header.kid || header.alg !== 'RS256') {
      throw new OAuthFlowInvalidException(
        'Google ID token header không hợp lệ',
      );
    }
    const keys = await this.getGoogleJwks();
    const jwk = keys.find((item) => item.kid === header.kid);
    if (!jwk)
      throw new OAuthFlowInvalidException('Không tìm thấy khóa ký Google');
    const key = createPublicKey({ key: jwk, format: 'jwk' });
    const payload = verify(token, key, {
      algorithms: ['RS256'],
      audience,
      issuer: ['https://accounts.google.com', 'accounts.google.com'],
    });
    if (typeof payload === 'string') throw new OAuthFlowInvalidException();
    return payload;
  }

  private async getGoogleJwks(): Promise<GoogleJwk[]> {
    if (this.googleJwks && this.googleJwks.expiresAt > Date.now()) {
      return this.googleJwks.keys;
    }
    const response = await fetchWithTimeout(
      'https://www.googleapis.com/oauth2/v3/certs',
    );
    if (!response.ok) throw new Error(`Google JWKS ${response.status}`);
    const body = (await response.json()) as { keys?: GoogleJwk[] };
    if (!Array.isArray(body.keys)) throw new Error('Google JWKS missing');
    const cacheControl = response.headers.get('cache-control') ?? '';
    const maxAge = Number(/max-age=(\d+)/u.exec(cacheControl)?.[1] ?? 300);
    this.googleJwks = {
      keys: body.keys,
      expiresAt: Date.now() + maxAge * 1000,
    };
    return body.keys;
  }

  private async resolveAccount(
    profile: OAuthProfile,
  ): Promise<LoginAccountRecord> {
    const linked = await this.findLinkedUserId(profile);
    if (linked) {
      return this.loadAccount(linked);
    }

    const emailUser = await this.prisma.user.findUnique({
      where: { email: profile.email },
      select: { id: true, emailVerifiedAt: true },
    });
    if (emailUser) {
      if (!emailUser.emailVerifiedAt) {
        throw new OAuthAccountLinkingRequiredException();
      }

      const existingProviderLink = await this.prisma.oAuthAccount.findFirst({
        where: {
          userId: emailUser.id,
          provider: profile.provider,
        },
        select: { id: true },
      });
      if (existingProviderLink) {
        throw new OAuthAccountLinkingRequiredException();
      }

      try {
        await this.prisma.$transaction(async (tx) => {
          const oauthAccount = await tx.oAuthAccount.create({
            data: {
              userId: emailUser.id,
              provider: profile.provider,
              providerAccountId: profile.providerAccountId,
            },
            select: { id: true },
          });
          await this.auditWriter.write(tx, {
            actorId: emailUser.id,
            action: AuthAuditAction.OAUTH_ACCOUNT_LINKED,
            entityType: 'oauth_account',
            entityId: oauthAccount.id,
            newValues: { provider: profile.provider },
          });
        });
        return this.loadAccount(emailUser.id);
      } catch (error) {
        const racedUserId = await this.findLinkedUserId(profile);
        if (racedUserId) {
          return this.loadAccount(racedUserId);
        }
        throw error;
      }
    }

    const defaultRole = await this.prisma.role.findUnique({
      where: { code: RoleCode.USER },
      select: { id: true },
    });
    if (!defaultRole) {
      throw new OAuthProviderUnavailableException('default-role');
    }

    const username = await this.uniqueUsername(
      profile.usernameHint,
      profile.providerAccountId,
    );
    try {
      const user = await this.prisma.$transaction(async (tx) => {
        const created = await tx.user.create({
          data: {
            email: profile.email,
            username,
            displayName: profile.displayName.slice(0, 120),
            emailVerifiedAt: new Date(),
            oauthAccounts: {
              create: {
                provider: profile.provider,
                providerAccountId: profile.providerAccountId,
              },
            },
            userRoles: { create: { roleId: defaultRole.id } },
          },
          select: { id: true },
        });
        await this.auditWriter.write(tx, {
          actorId: created.id,
          action: AuthAuditAction.OAUTH_ACCOUNT_CREATED,
          entityType: 'user',
          entityId: created.id,
          newValues: { provider: profile.provider },
        });
        return created;
      });
      return this.loadAccount(user.id);
    } catch (error) {
      const racedUserId = await this.findLinkedUserId(profile);
      if (racedUserId) {
        return this.loadAccount(racedUserId);
      }
      throw error;
    }
  }

  private async findLinkedUserId(
    profile: Pick<OAuthProfile, 'provider' | 'providerAccountId'>,
  ): Promise<string | null> {
    const account = await this.prisma.oAuthAccount.findUnique({
      where: {
        provider_providerAccountId: {
          provider: profile.provider,
          providerAccountId: profile.providerAccountId,
        },
      },
      select: { userId: true },
    });
    return account?.userId ?? null;
  }

  private async loadAccount(userId: string): Promise<LoginAccountRecord> {
    const now = new Date();
    const user = await this.prisma.user.findUnique({
      where: { id: userId },
      select: {
        id: true,
        email: true,
        username: true,
        displayName: true,
        passwordHash: true,
        status: true,
        deletedAt: true,
        emailVerifiedAt: true,
        adminMfaCredential: { select: { enabledAt: true } },
        userRoles: {
          where: { OR: [{ expiresAt: null }, { expiresAt: { gt: now } }] },
          select: { role: { select: { code: true } } },
        },
      },
    });
    if (!user) throw new OAuthFlowInvalidException();
    const validRoles = new Set<string>(Object.values(RoleCode));
    return {
      id: user.id,
      email: user.email,
      username: user.username,
      displayName: user.displayName,
      passwordHash: user.passwordHash,
      status: user.status as AuthAccountStatus,
      deletedAt: user.deletedAt,
      emailVerifiedAt: user.emailVerifiedAt,
      roles: user.userRoles
        .map(({ role }) => role.code)
        .filter((code): code is RoleCode => validRoles.has(code)),
      mfaEnabled: user.adminMfaCredential !== null,
    };
  }

  private async uniqueUsername(
    hint: string,
    providerAccountId: string,
  ): Promise<string> {
    const base =
      hint
        .toLowerCase()
        .replace(/[^a-z0-9_]/gu, '_')
        .replace(/_+/gu, '_')
        .replace(/^_+|_+$/gu, '')
        .slice(0, 36) || 'oauth_user';
    const suffix = sha256(providerAccountId).slice(0, 8);
    for (let attempt = 0; attempt < 10; attempt += 1) {
      const candidate = `${base}_${
        attempt === 0 ? suffix : `${suffix}${attempt}`
      }`.slice(0, 50);
      const exists = await this.prisma.user.findUnique({
        where: { username: candidate },
        select: { id: true },
      });
      if (!exists) return candidate;
    }
    throw new OAuthFlowInvalidException(
      'Không thể tạo username cho tài khoản OAuth',
    );
  }

  private async createSession(
    account: LoginAccountRecord,
    client: LoginClientContext,
    authenticationMethod: 'google' | 'github',
  ): Promise<LoginResultDto> {
    const sessionId = this.idGenerator.generate();
    const refreshTokenFamilyId = this.idGenerator.generate();
    const tokens = this.tokenIssuer.issue({
      userId: account.id,
      sessionId,
      refreshTokenFamilyId,
      accessTokenVersion: 0,
      refreshTokenVersion: 0,
    });
    const loggedInAt = new Date();
    await this.loginPersistence.createSession({
      id: sessionId,
      userId: account.id,
      refreshTokenHash: this.secureToken.hash(tokens.refreshToken),
      refreshTokenFamilyId,
      refreshTokenVersion: 0,
      accessTokenVersion: 0,
      authenticationMethod,
      deviceId: client.deviceId,
      deviceName: client.deviceName,
      ipAddress: client.ipAddress,
      userAgent: client.userAgent,
      loggedInAt,
      expiresAt: tokens.refreshTokenExpiresAt,
    });
    return LoginResultMapper.toDto(account, sessionId, tokens);
  }

  private providerSettings(provider: 'google' | 'github') {
    if (!this.config.oauth.enabled) {
      throw new OAuthProviderUnavailableException(provider);
    }
    const settings = this.config.oauth[provider];
    if (
      !settings.enabled ||
      !settings.clientId ||
      !settings.clientSecret ||
      !settings.callbackUrl
    ) {
      throw new OAuthProviderUnavailableException(provider);
    }
    return {
      clientId: settings.clientId,
      clientSecret: settings.clientSecret,
      callbackUrl: settings.callbackUrl,
    };
  }

  private async consumeState(
    state: string | undefined,
  ): Promise<OAuthStateRecord> {
    if (!state || state.length > 256) {
      throw new OAuthFlowInvalidException();
    }
    const raw = await this.requireRedis().getdel(this.stateKey(state));
    if (!raw) {
      throw new OAuthFlowInvalidException();
    }

    try {
      const value = JSON.parse(raw) as Partial<OAuthStateRecord>;
      if (
        (value.provider !== 'google' && value.provider !== 'github') ||
        typeof value.verifier !== 'string' ||
        !value.verifier ||
        typeof value.expiresAt !== 'string' ||
        !Number.isFinite(Date.parse(value.expiresAt)) ||
        !value.client ||
        typeof value.client !== 'object'
      ) {
        throw new Error('invalid OAuth state');
      }
      return value as OAuthStateRecord;
    } catch {
      throw new OAuthFlowInvalidException();
    }
  }

  private stateKey(state: string): string {
    return `auth:oauth:state:${sha256(state)}`;
  }

  private requireRedis(): Redis {
    if (!this.redis) {
      throw new ServiceUnavailableException({
        code: 'AUTH_OAUTH_STATE_STORE_UNAVAILABLE',
        message: 'Dịch vụ OAuth tạm thời không khả dụng',
        service: 'redis',
      });
    }
    return this.redis;
  }
}

function parseProvider(value: string): 'google' | 'github' {
  const normalized = value.trim().toLowerCase();
  if (normalized !== 'google' && normalized !== 'github') {
    throw new InvalidInputException({
      code: 'AUTH_OAUTH_PROVIDER_UNSUPPORTED',
      message: 'OAuth provider không được hỗ trợ',
      details: { provider: value },
    });
  }
  return normalized;
}

function validateStateBinding(
  state: string | undefined,
  browserState: string,
): string {
  if (
    !state ||
    state.length > 256 ||
    browserState.length > 256 ||
    !timingSafeEqualStrings(state, browserState)
  ) {
    throw new OAuthFlowInvalidException();
  }

  return state;
}

function sha256Buffer(value: string): Buffer {
  return Buffer.from(sha256(value), 'hex');
}

async function fetchWithTimeout(
  url: string,
  init: RequestInit = {},
): Promise<Response> {
  return fetch(url, { ...init, signal: AbortSignal.timeout(10_000) });
}

async function fetchJson(
  url: string,
  init: RequestInit = {},
): Promise<unknown> {
  const response = await fetchWithTimeout(url, init);
  if (!response.ok) throw new Error(`HTTP ${response.status}`);
  return response.json();
}

function isObject(value: unknown): value is Record<string, unknown> {
  return Boolean(value) && typeof value === 'object' && !Array.isArray(value);
}

function stringField(value: unknown, field: string): string {
  if (!isObject(value) || typeof value[field] !== 'string' || !value[field]) {
    throw new Error(`Missing ${field}`);
  }
  return value[field];
}

function numberOrStringField(value: unknown, field: string): number | string {
  if (
    !isObject(value) ||
    (typeof value[field] !== 'number' && typeof value[field] !== 'string')
  ) {
    throw new Error(`Missing ${field}`);
  }
  return value[field];
}

function requiredClaim(payload: JwtPayload, field: string): string {
  const value = payload[field];
  if (typeof value !== 'string' || !value) {
    throw new OAuthFlowInvalidException(`Thiếu claim ${field}`);
  }
  return value;
}

function optionalClaim(payload: JwtPayload, field: string): string | undefined {
  const value = payload[field];
  return typeof value === 'string' && value ? value : undefined;
}

function mergeClient(
  original: LoginClientContext,
  override: LoginClientContext,
): LoginClientContext {
  return {
    ipAddress: override.ipAddress ?? original.ipAddress,
    userAgent: override.userAgent ?? original.userAgent,
    deviceId: override.deviceId ?? original.deviceId,
    deviceName: override.deviceName ?? original.deviceName,
  };
}
