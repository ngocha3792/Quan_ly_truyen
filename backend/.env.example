# ============================================================
# APPLICATION
# ============================================================
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
APP_PUBLIC_URL=http://localhost:3000
TRUST_PROXY=false

# ============================================================
# OBSERVABILITY
# ============================================================
OBSERVABILITY_ENABLED=true
LOG_LEVEL=debug
LOG_PRETTY=true
LOG_INCLUDE_SOURCE=false
SERVICE_INSTANCE_ID=

METRICS_ENABLED=true
METRICS_PATH=/internal/metrics
METRICS_BEARER_TOKEN=local-observability-token-change-me-32chars
METRICS_DEFAULT_ENABLED=true
METRICS_SNAPSHOT_INTERVAL_MS=10000

OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=quan-ly-truyen-api
OTEL_SERVICE_VERSION=0.0.1
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_BSP_EXPORT_TIMEOUT=3000
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512
OTEL_BSP_SCHEDULE_DELAY=5000

# Production observability / recovery objectives.
# Production values are normally generated by New-ProductionEnv.ps1.
ALERTMANAGER_IMAGE=prom/alertmanager:replace-with-pinned-tag
BACKUP_RPO_HOURS=26
RESTORE_DRILL_MAX_AGE_DAYS=8
RECOVERY_METRICS_MEMORY_LIMIT=128m
RECOVERY_METRICS_CPU_LIMIT=0.25
ALERTMANAGER_MEMORY_LIMIT=256m
ALERTMANAGER_CPU_LIMIT=0.25

# ============================================================
# HTTP
# ============================================================
HTTP_REQUEST_TIMEOUT_MS=15000
JSON_BODY_LIMIT=2mb
URL_ENCODED_BODY_LIMIT=2mb
SWAGGER_ENABLED=true

# ============================================================
# LOCALE
# ============================================================
DEFAULT_LOCALE=vi-VN
SUPPORTED_LOCALES=vi-VN,en-US

# ============================================================
# CORS
# ============================================================
CORS_ALLOWED_ORIGINS=http://localhost:4200
CORS_CREDENTIALS=true
CORS_MAX_AGE_SECONDS=86400

# ============================================================
# DATABASE
# ============================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/quan_ly_truyen?schema=public

# ============================================================
# AUTHENTICATION
# ============================================================
JWT_ACCESS_SECRET=local-access-secret-change-me-at-least-32-characters
JWT_REFRESH_SECRET=local-refresh-secret-change-me-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_ISSUER=quan-ly-truyen-api
JWT_AUDIENCE=quan-ly-truyen-web

AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/api/v1/auth

AUTH_LOGIN_RATE_LIMIT_ENABLED=true
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_LOGIN_RATE_LIMIT_IP_LIMIT=20
AUTH_LOGIN_RATE_LIMIT_IDENTIFIER_LIMIT=5

AUTH_JWT_BLACKLIST_ENABLED=true
AUTH_JWT_BLACKLIST_FAILURE_MODE=closed

# Admin MFA is mandatory in production. Generate a fresh 32-byte base64 key.
AUTH_ADMIN_MFA_ENABLED=true
AUTH_ADMIN_MFA_ISSUER=Quan Ly Truyen
AUTH_MFA_ENCRYPTION_KEY=BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc=
AUTH_MFA_PREAUTH_TTL_SECONDS=300
AUTH_MFA_MAX_VERIFICATION_ATTEMPTS=5
AUTH_MFA_TOTP_WINDOW=1
AUTH_MFA_RECOVERY_CODE_COUNT=10

# OAuth login-only: provider access tokens are not persisted.
AUTH_OAUTH_ENABLED=false
AUTH_OAUTH_STATE_TTL_SECONDS=600
AUTH_OAUTH_STATE_COOKIE_NAME=oauth_state
AUTH_OAUTH_GOOGLE_ENABLED=false
AUTH_OAUTH_GOOGLE_CLIENT_ID=
AUTH_OAUTH_GOOGLE_CLIENT_SECRET=
AUTH_OAUTH_GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/google/callback
AUTH_OAUTH_GITHUB_ENABLED=false
AUTH_OAUTH_GITHUB_CLIENT_ID=
AUTH_OAUTH_GITHUB_CLIENT_SECRET=
AUTH_OAUTH_GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/github/callback

AUTH_CSRF_ENABLED=true
AUTH_CSRF_SECRET=local-csrf-secret-change-me-and-keep-different-from-jwt-secrets
AUTH_CSRF_COOKIE_NAME=csrf_token
AUTH_CSRF_COOKIE_DOMAIN=
AUTH_CSRF_COOKIE_PATH=/

AUTH_EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
AUTH_PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=60
# ============================================================
# REDIS / QUEUE
# ============================================================
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=qlt
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=3000
CACHE_DEFAULT_TTL_SECONDS=300
QUEUE_ENABLED=true
QUEUE_PREFIX=qlt
QUEUE_DEFAULT_ATTEMPTS=3
QUEUE_DEFAULT_BACKOFF_MS=5000
WORKER_CONCURRENCY=5
WORKER_ROLE=all
OUTBOX_PROCESSING_TIMEOUT_MS=60000
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_MS=10000

# Idempotency/lock fallback is intentionally fail-closed by default.
IDEMPOTENCY_FAILURE_MODE=closed
IDEMPOTENCY_MAX_RESPONSE_BYTES=1048576
IDEMPOTENCY_PROCESSING_LEASE_TTL_SECONDS=120
ALLOW_IN_MEMORY_INFRASTRUCTURE_FALLBACK=false
IN_MEMORY_STORE_MAX_ENTRIES=10000
IN_MEMORY_STORE_SWEEP_INTERVAL_MS=60000

# ============================================================
# MAIL / SMTP
# ============================================================
# Generate bằng:
# openssl rand -base64 32
MAIL_PAYLOAD_ENCRYPTION_KEY=BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc=

# Tạm thời true để đọc các plaintext job cũ.
# Sau khi queue/outbox cũ đã drain hết thì đổi false.
MAIL_PAYLOAD_ALLOW_LEGACY_PLAINTEXT_READ=true
MAIL_ENABLED=true
MAIL_FROM_NAME=Quan Ly Truyen
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_REPLY_TO=support@example.com
FRONTEND_PUBLIC_URL=http://localhost:4200
MAIL_MESSAGE_ID_DOMAIN=mail.example.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_POOL_ENABLED=true
SMTP_MAX_CONNECTIONS=3
SMTP_MAX_MESSAGES=100
SMTP_RATE_LIMIT_PER_SECOND=5
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000
SMTP_VERIFY_ON_STARTUP=true
MAIL_DKIM_ENABLED=false
MAIL_DKIM_DOMAIN=
MAIL_DKIM_SELECTOR=
MAIL_DKIM_PRIVATE_KEY_BASE64=

# ============================================================
# MAINTENANCE
# ============================================================
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=Hệ thống đang bảo trì
MAINTENANCE_RETRY_AFTER_SECONDS=300
MAINTENANCE_BYPASS_HEADER=x-maintenance-key
MAINTENANCE_BYPASS_TOKEN=

# ============================================================
# CLOUDINARY MEDIA
# ============================================================
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret

CLOUDINARY_ROOT_FOLDER=quan-ly-truyen
CLOUDINARY_SIGNATURE_ALGORITHM=sha256
CLOUDINARY_UPLOAD_INTENT_TTL_SECONDS=300
CLOUDINARY_READY_ORPHAN_GRACE_SECONDS=3600
CLOUDINARY_WEBHOOK_SIGNATURE_TTL_SECONDS=300
CLOUDINARY_WEBHOOK_POLL_INTERVAL_MS=1000
CLOUDINARY_WEBHOOK_BATCH_SIZE=100
CLOUDINARY_WEBHOOK_MAX_ATTEMPTS=5
CLOUDINARY_WEBHOOK_RETRY_BASE_MS=5000
CLOUDINARY_DELETE_MAX_ATTEMPTS=5
CLOUDINARY_DELETE_RETRY_BASE_MS=5000

CLOUDINARY_AVATAR_UPLOAD_PRESET=qlt_avatar_signed
CLOUDINARY_AUTHOR_BANNER_UPLOAD_PRESET=qlt_author_banner_signed
CLOUDINARY_STORY_COVER_UPLOAD_PRESET=qlt_story_cover_signed
CLOUDINARY_CHAPTER_IMAGE_UPLOAD_PRESET=qlt_chapter_image_signed
CLOUDINARY_ATTACHMENT_UPLOAD_PRESET=qlt_attachment_signed

OUTBOX_FAILED_ALERT_THRESHOLD=5
QUEUE_WORKER_HEARTBEAT_ENABLED=true
QUEUE_WORKER_HEARTBEAT_INTERVAL_MS=10000
QUEUE_WORKER_HEARTBEAT_TTL_SECONDS=30
# Mail queue retention
# BullMQ age sử dụng đơn vị giây.

# Completed mail jobs:
# giữ tối đa 1 giờ hoặc 100 jobs.
MAIL_QUEUE_COMPLETED_RETENTION_SECONDS=3600
MAIL_QUEUE_COMPLETED_RETENTION_COUNT=100

# Failed mail jobs:
# giữ tối đa 7 ngày hoặc 1000 jobs.
MAIL_QUEUE_FAILED_RETENTION_SECONDS=604800
MAIL_QUEUE_FAILED_RETENTION_COUNT=1000


# ============================================================
# TESTING (Integration & E2E)
# ============================================================
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/quan_ly_truyen_test?schema=public
TEST_REDIS_URL=redis://localhost:6379/1

# Đặt true nếu bạn chấp nhận dùng database tên không chứa "test"
ALLOW_UNSAFE_TEST_DB=false

# Session management
#
# Khi login tạo session thứ 11, session cũ nhất
# sẽ bị revoke tự động.
AUTH_MAX_ACTIVE_SESSIONS=10

# Phải lớn hơn hoặc bằng AUTH_MAX_ACTIVE_SESSIONS.
AUTH_SESSION_LIST_LIMIT=20

# Số security event tối đa user có thể đọc mỗi request.
AUTH_SECURITY_EVENT_HISTORY_LIMIT=50

# Production gate
#
# Folder này phải tồn tại trong Docker image production.
PRODUCTION_GATE_MIGRATIONS_PATH=prisma/migrations

# Auth cleanup, outbox cleanup và mail queue cleanup
# không được cũ hơn số giờ này.
PRODUCTION_GATE_CLEANUP_MAX_AGE_HOURS=30

# Chỉ cache role, permission và authorProfileId.
# Session version/revocation luôn đọc từ PostgreSQL.
AUTH_ACCESS_AUTHORIZATION_CACHE_ENABLED=true

# TTL ngắn; không nên vượt quá 60 giây.
AUTH_ACCESS_AUTHORIZATION_CACHE_TTL_SECONDS=15
