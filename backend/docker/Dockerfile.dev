# syntax=docker/dockerfile:1.7

FROM node:24.15.0-bookworm-slim

ARG NPM_VERSION=11.12.1

WORKDIR /app

ENV NODE_ENV=development
ENV CI=false
ENV NPM_CONFIG_UPDATE_NOTIFIER=false
ENV NPM_CONFIG_FUND=false
ENV NPM_CONFIG_AUDIT=false

# Prisma config đọc DATABASE_URL trong lúc chạy postinstall.
# Đây chỉ là URL build-time; prisma generate không kết nối database.
# Docker development env file will override this when the container starts.
ENV DATABASE_URL="postgresql://postgres:postgres@postgres:5432/quan_ly_truyen?schema=public&sslmode=disable"

RUN npm install --global "npm@${NPM_VERSION}" \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    dumb-init \
    openssl \
    && rm -rf /var/lib/apt/lists/*



COPY package.json package-lock.json .npmrc ./

COPY prisma.config.ts ./
COPY prisma ./prisma

# npm ci chạy postinstall -> prisma generate.
RUN npm ci

COPY --chown=node:node prisma ./prisma
COPY --chown=node:node src ./src
COPY --chown=node:node test ./test
COPY --chown=node:node scripts ./scripts

COPY --chown=node:node nest-cli.json ./
COPY --chown=node:node tsconfig.json ./
COPY --chown=node:node tsconfig.build.json ./
COPY . .

EXPOSE 3000

ENTRYPOINT ["dumb-init", "--"]

CMD ["npm", "run", "start:dev"]
