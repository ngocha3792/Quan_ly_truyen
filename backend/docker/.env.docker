# Docker-only development defaults. Do not reuse these secrets in production.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
APP_PUBLIC_URL=http://localhost:3000
FRONTEND_PUBLIC_URL=http://localhost:4200
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/quan_ly_truyen?schema=public
TEST_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/quan_ly_truyen_test?schema=public

REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0
TEST_REDIS_URL=redis://redis:6379/1
REDIS_KEY_PREFIX=qlt
QUEUE_ENABLED=true
QUEUE_PREFIX=qlt

MAIL_ENABLED=true
MAIL_PAYLOAD_ENCRYPTION_KEY=BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc=
MAIL_PAYLOAD_ALLOW_LEGACY_PLAINTEXT_READ=false
MAIL_FROM_NAME=Quan Ly Truyen
MAIL_FROM_ADDRESS=no-reply@example.test
MAIL_REPLY_TO=support@example.test
MAIL_MESSAGE_ID_DOMAIN=mail.example.test
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_VERIFY_ON_STARTUP=true

JWT_ACCESS_SECRET=docker-access-secret-change-me-at-least-32-characters
JWT_REFRESH_SECRET=docker-refresh-secret-change-me-at-least-32-characters
JWT_ISSUER=quan-ly-truyen-api
JWT_AUDIENCE=quan-ly-truyen-web

AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_PATH=/api/v1/auth
AUTH_LOGIN_RATE_LIMIT_ENABLED=true
AUTH_JWT_BLACKLIST_ENABLED=true
AUTH_JWT_BLACKLIST_FAILURE_MODE=closed
AUTH_CSRF_ENABLED=true
AUTH_CSRF_SECRET=docker-csrf-secret-change-me-and-keep-different-from-jwt
AUTH_CSRF_COOKIE_NAME=csrf_token
AUTH_CSRF_COOKIE_PATH=/
AUTH_MAX_ACTIVE_SESSIONS=10
AUTH_SESSION_LIST_LIMIT=20
AUTH_SECURITY_EVENT_HISTORY_LIMIT=50
AUTH_ACCESS_AUTHORIZATION_CACHE_ENABLED=true
AUTH_ACCESS_AUTHORIZATION_CACHE_TTL_SECONDS=15

CORS_ALLOWED_ORIGINS=http://localhost:4200
CORS_CREDENTIALS=true
CLOUDINARY_ENABLED=false
OBSERVABILITY_ENABLED=false
METRICS_ENABLED=false
OTEL_SDK_DISABLED=true
SWAGGER_ENABLED=true
LOG_LEVEL=debug
LOG_PRETTY=true
ALLOW_UNSAFE_TEST_DB=false
