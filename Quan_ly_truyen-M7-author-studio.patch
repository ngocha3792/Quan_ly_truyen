@@ -0,0 +1,127 @@
+<main class="studio-page">
+  <header class="page-header">
+    <div>
+      <a routerLink="/author-studio/truyen">← Truyện của tôi</a>
+      <h1>{{ isCreate() ? 'Tạo truyện mới' : 'Chỉnh sửa truyện' }}</h1>
+      @if (store.story(); as story) {
+        <p>Trạng thái: <strong>{{ statusLabel(story) }}</strong> · phiên bản {{ story.version }}</p>
+      } @else {
+        <p>Tạo bản nháp trước, sau đó bạn có thể tải ảnh bìa và viết chương.</p>
+      }
+    </div>
+
+    @if (store.story(); as story) {
+      <a class="secondary-action" [routerLink]="['/author-studio/truyen', story.id, 'chuong']">
+        Quản lý chương
+      </a>
+    }
+  </header>
+
+  @if (store.error()) { <p class="notice notice--error">{{ store.error() }}</p> }
+  @if (fileError()) { <p class="notice notice--error">{{ fileError() }}</p> }
+
+  @if (store.loading()) {
+    <p class="notice">Đang tải dữ liệu truyện...</p>
+  } @else {
+    @if (!isEditable()) {
+      <p class="notice">
+        Truyện ở trạng thái hiện tại chỉ đọc. Nếu đang chờ duyệt, hãy hủy yêu cầu duyệt trước khi chỉnh sửa.
+      </p>
+    }
+
+    <form class="editor-grid" [formGroup]="form" (ngSubmit)="save()">
+      <section class="panel main-panel">
+        <label>
+          <span>Tên truyện</span>
+          <input type="text" formControlName="title" maxlength="255" />
+        </label>
+
+        <label>
+          <span>Mô tả</span>
+          <textarea rows="9" formControlName="synopsis" placeholder="Giới thiệu nội dung truyện..."></textarea>
+        </label>
+
+        <div class="field-group">
+          <span class="field-label">Thể loại</span>
+          <div class="chip-list">
+            @for (category of store.categories(); track category.id) {
+              <button
+                type="button"
+                class="chip"
+                [class.chip--selected]="isCategorySelected(category.id)"
+                [disabled]="!isEditable()"
+                (click)="toggleCategory(category.id)"
+              >{{ category.name }}</button>
+            }
+          </div>
+        </div>
+
+        <div class="field-group">
+          <span class="field-label">Tag</span>
+          <div class="chip-list">
+            @for (tag of store.tags(); track tag.id) {
+              <button
+                type="button"
+                class="chip"
+                [class.chip--selected]="isTagSelected(tag.id)"
+                [disabled]="!isEditable()"
+                (click)="toggleTag(tag.id)"
+              >{{ tag.name }}</button>
+            }
+          </div>
+        </div>
+      </section>
+
+      <aside class="panel side-panel">
+        <h2>Ảnh bìa</h2>
+        <div class="cover-box">
+          @if (displayedCoverUrl(); as coverUrl) {
+            <img [src]="coverUrl" alt="Ảnh bìa truyện" />
+          } @else {
+            <span>Chưa có ảnh bìa</span>
+          }
+        </div>
+
+        @if (isEditable()) {
+          <label class="file-action">
+            Chọn ảnh JPG / PNG / WebP
+            <input type="file" accept="image/jpeg,image/png,image/webp" (change)="selectCover($event)" />
+          </label>
+          @if (displayedCoverUrl()) {
+            <button type="button" class="text-danger" (click)="removeCover()">Gỡ ảnh bìa</button>
+          }
+        }
+
+        <button class="primary-action" type="submit" [disabled]="!isEditable() || store.saving()">
+          {{ store.saving() ? 'Đang lưu...' : 'Lưu bản nháp' }}
+        </button>
+
+        @if (canSubmit()) {
+          <hr />
+          <label>
+            <span>Ghi chú cho người duyệt</span>
+            <textarea rows="3" maxlength="2000" [value]="authorNote()" (input)="updateAuthorNote($event)"></textarea>
+          </label>
+          @if (hasUnsavedChanges()) {
+            <small>Hãy lưu các thay đổi trước khi gửi duyệt.</small>
+          }
+          <button
+            type="button"
+            class="review-action"
+            [disabled]="store.workflowBusy() || hasUnsavedChanges()"
+            (click)="submitForReview()"
+          >{{ store.workflowBusy() ? 'Đang gửi...' : 'Gửi duyệt' }}</button>
+        }
+
+        @if (canCancel()) {
+          <button
+            type="button"
+            class="review-action review-action--cancel"
+            [disabled]="store.workflowBusy()"
+            (click)="cancelReview()"
+          >Hủy yêu cầu duyệt</button>
+        }
+      </aside>
+    </form>
+  }
+</main>
