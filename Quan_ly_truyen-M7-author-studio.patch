+                <button
+                  type="button"
+                  class="danger"
+                  [disabled]="store.actionChapterId() === chapter.id"
+                  (click)="deleteChapter(story, chapter)"
+                >Xóa</button>
+              }
+              @if (canPublish(story, chapter)) {
+                <button
+                  type="button"
+                  class="publish"
+                  [disabled]="store.actionChapterId() === chapter.id"
+                  (click)="publishChapter(story, chapter)"
+                >Xuất bản</button>
+              }
+            </div>
+          </article>
+        }
+      </section>
+    }
+  } @else if (store.loading()) {
+    <p class="notice">Đang tải danh sách chương...</p>
+  } @else if (store.error()) {
+    <p class="notice notice--error">{{ store.error() }}</p>
+  }
+</main>
