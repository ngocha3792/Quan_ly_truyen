{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "start": "ng serve --proxy-config proxy.conf.json",
    "lint": "ng lint",
    "lint:check": "ng lint --max-warnings=0",
    "architecture:check": "node ./scripts/check-architecture.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "test": "ng test",
    "test:ci": "ng test --no-watch --no-progress",
    "build:ci": "ng build --configuration production",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,html,scss,css,json}\" \"e2e/**/*.ts\" \"*.{ts,js,mjs,json,md}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,css,json}\" \"e2e/**/*.ts\" \"*.{ts,js,mjs,json,md}\" \"scripts/**/*.mjs\"",
    "e2e:smoke": "playwright test --grep @smoke",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "e2e:prepare": "npm --prefix ../backend run db:seed && npm --prefix ../backend run db:seed:e2e && npm --prefix ../backend run db:seed:e2e:admin",
    "pree2e": "npm run e2e:prepare",
    "ci": "npm run format:check && npm run architecture:check && npm run lint:check && npm run typecheck && npm run typecheck:e2e && npm run test:ci && npm run build:ci"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@types/qrcode": "^1.5.6",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "angular-eslint": "^22.1.0",
    "eslint": "^9.39.5",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  }
}
