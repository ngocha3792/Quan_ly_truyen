{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "start": "ng serve --proxy-config proxy.conf.json",
    "lint": "ng lint",
    "test:ci": "ng test --watch=false --code-coverage",
    "build:ci": "ng build --configuration production",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,html,scss,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,css,json}\"",
    "e2e:smoke": "playwright test --grep @smoke",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@types/qrcode": "^1.5.6",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@playwright/test": "^1.62.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "wait-on": "^9.1.0"
  }
}