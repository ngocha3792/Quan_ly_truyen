diff --git a/.github/workflows/deploy-environment.yml b/.github/workflows/deploy-environment.yml
new file mode 100644
index 0000000..34c86d6
--- /dev/null
+++ b/.github/workflows/deploy-environment.yml
@@ -0,0 +1,432 @@
+name: Deploy Environment
+
+on:
+  workflow_dispatch:
+    inputs:
+      environment:
+        description: GitHub Environment and deployment target
+        required: true
+        type: choice
+        options:
+          - staging
+          - production
+      source_sha:
+        description: Full 40-character Git SHA from main
+        required: true
+        type: string
+      deployment_mode:
+        description: Registry for immutable release images; Local is staging-only
+        required: true
+        default: Registry
+        type: choice
+        options:
+          - Registry
+          - Local
+
+permissions:
+  contents: read
+
+concurrency:
+  group: deploy-${{ inputs.environment }}
+  cancel-in-progress: false
+
+jobs:
+  verify:
+    name: Verify release candidate
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+
+    permissions:
+      actions: read
+      contents: read
+      packages: read
+
+    outputs:
+      source_sha: ${{ steps.source.outputs.sha }}
+
+    steps:
+      - name: Validate deployment policy
+        shell: bash
+        env:
+          DEPLOY_ENVIRONMENT: ${{ inputs.environment }}
+          DEPLOYMENT_MODE: ${{ inputs.deployment_mode }}
+        run: |
+          set -euo pipefail
+
+          if [[ "${DEPLOY_ENVIRONMENT}" == "production" && "${DEPLOYMENT_MODE}" != "Registry" ]]; then
+            echo 'Production deployments must use Registry mode.'
+            exit 1
+          fi
+
+      - name: Checkout release candidate
+        uses: actions/checkout@v6
+        with:
+          ref: ${{ inputs.source_sha }}
+          fetch-depth: 0
+
+      - name: Verify immutable SHA belongs to main
+        id: source
+        shell: bash
+        env:
+          REQUESTED_SHA: ${{ inputs.source_sha }}
+        run: |
+          set -euo pipefail
+
+          if ! [[ "${REQUESTED_SHA}" =~ ^[0-9a-fA-F]{40}$ ]]; then
+            echo 'source_sha must be a full 40-character Git SHA.'
+            exit 1
+          fi
+
+          actual_sha="$(git rev-parse HEAD)"
+          requested_sha="${REQUESTED_SHA,,}"
+
+          if [[ "${actual_sha}" != "${requested_sha}" ]]; then
+            echo "Checkout drift detected: expected ${requested_sha}, got ${actual_sha}."
+            exit 1
+          fi
+
+          git fetch --no-tags origin main
+
+          if ! git merge-base --is-ancestor "${actual_sha}" origin/main; then
+            echo "${actual_sha} is not reachable from main."
+            exit 1
+          fi
+
+          echo "sha=${actual_sha}" >> "${GITHUB_OUTPUT}"
+
+      - name: Require successful full CI for exact SHA
+        shell: bash
+        env:
+          GH_TOKEN: ${{ github.token }}
+          SOURCE_SHA: ${{ steps.source.outputs.sha }}
+        run: |
+          set -euo pipefail
+
+          runs_json="$(
+            gh api \
+              --method GET \
+              "/repos/${GITHUB_REPOSITORY}/actions/workflows/ci.yml/runs" \
+              -f head_sha="${SOURCE_SHA}" \
+              -f per_page=100
+          )"
+
+          successful_run="$(
+            jq -c \
+              --arg sha "${SOURCE_SHA}" \
+              '[
+                .workflow_runs[]
+                | select(.head_sha == $sha)
+                | select(.event == "push")
+                | select(.head_branch == "main")
+                | select(.status == "completed")
+                | select(.conclusion == "success")
+              ]
+              | sort_by(.run_number)
+              | reverse
+              | .[0] // empty' \
+              <<<"${runs_json}"
+          )"
+
+          if [[ -z "${successful_run}" ]]; then
+            echo "No successful CI run exists for ${SOURCE_SHA} on main."
+            exit 1
+          fi
+
+          echo "Verified CI: $(jq -r '.html_url' <<<"${successful_run}")"
+
+      - name: Setup Docker Buildx
+        if: inputs.deployment_mode == 'Registry'
+        uses: docker/setup-buildx-action@v3
+
+      - name: Login to GHCR for manifest verification
+        if: inputs.deployment_mode == 'Registry'
+        uses: docker/login-action@v3
+        with:
+          registry: ghcr.io
+          username: ${{ github.actor }}
+          password: ${{ secrets.GITHUB_TOKEN }}
+
+      - name: Require all immutable application images
+        if: inputs.deployment_mode == 'Registry'
+        shell: bash
+        env:
+          SOURCE_SHA: ${{ steps.source.outputs.sha }}
+        run: |
+          set -euo pipefail
+
+          owner="${GITHUB_REPOSITORY_OWNER,,}"
+
+          images=(
+            "ghcr.io/${owner}/quan-ly-truyen-backend:${SOURCE_SHA}"
+            "ghcr.io/${owner}/quan-ly-truyen-backend-migrate:${SOURCE_SHA}"
+            "ghcr.io/${owner}/quan-ly-truyen-frontend:${SOURCE_SHA}"
+          )
+
+          for image in "${images[@]}"; do
+            echo "Verifying ${image}"
+            docker buildx imagetools inspect "${image}" >/dev/null
+          done
+
+  deploy:
+    name: Deploy ${{ inputs.environment }}
+    needs: verify
+    runs-on: ubuntu-latest
+    timeout-minutes: 45
+
+    environment:
+      name: ${{ inputs.environment }}
+
+    permissions:
+      contents: read
+      packages: read
+
+    steps:
+      - name: Checkout verified source
+        uses: actions/checkout@v6
+        with:
+          ref: ${{ needs.verify.outputs.source_sha }}
+          fetch-depth: 1
+
+      - name: Configure pinned SSH host
+        shell: bash
+        env:
+          DEPLOY_SSH_PRIVATE_KEY: ${{ secrets.DEPLOY_SSH_PRIVATE_KEY }}
+          DEPLOY_KNOWN_HOSTS: ${{ secrets.DEPLOY_KNOWN_HOSTS }}
+        run: |
+          set -euo pipefail
+
+          test -n "${DEPLOY_SSH_PRIVATE_KEY}"
+          test -n "${DEPLOY_KNOWN_HOSTS}"
+
+          install -d -m 0700 "${HOME}/.ssh"
+          printf '%s\n' "${DEPLOY_SSH_PRIVATE_KEY}" > "${HOME}/.ssh/deploy_key"
+          printf '%s\n' "${DEPLOY_KNOWN_HOSTS}" > "${HOME}/.ssh/known_hosts"
+          chmod 0600 "${HOME}/.ssh/deploy_key" "${HOME}/.ssh/known_hosts"
+
+      - name: Validate deployment connection secrets
+        shell: bash
+        env:
+          DEPLOY_HOST: ${{ secrets.DEPLOY_HOST }}
+          DEPLOY_USER: ${{ secrets.DEPLOY_USER }}
+          DEPLOY_PATH: ${{ secrets.DEPLOY_PATH }}
+        run: |
+          set -euo pipefail
+          test -n "${DEPLOY_HOST}"
+          test -n "${DEPLOY_USER}"
+          test -n "${DEPLOY_PATH}"
+
+          if ! [[ "${DEPLOY_PATH}" =~ ^/[A-Za-z0-9._/-]+$ ]]; then
+            echo 'DEPLOY_PATH must be an absolute Linux path without whitespace.'
+            exit 1
+          fi
+
+      - name: Package deployment source
+        shell: bash
+        env:
+          SOURCE_SHA: ${{ needs.verify.outputs.source_sha }}
+        run: |
+          set -euo pipefail
+
+          tar \
+            --exclude='backend/.env*' \
+            --exclude='backend/backups' \
+            --exclude='backend/ops/production/secrets' \
+            --exclude='backend/ops/production/.deployment-state' \
+            --exclude='backend/node_modules' \
+            --exclude='backend/dist' \
+            --exclude='frontend/node_modules' \
+            --exclude='frontend/dist' \
+            --exclude='frontend/playwright-report' \
+            --exclude='frontend/test-results' \
+            -czf "${RUNNER_TEMP}/deployment-${SOURCE_SHA}.tar.gz" \
+            backend \
+            frontend
+
+      - name: Upload clean release source
+        shell: bash
+        env:
+          DEPLOY_HOST: ${{ secrets.DEPLOY_HOST }}
+          DEPLOY_PORT: ${{ secrets.DEPLOY_PORT }}
+          DEPLOY_USER: ${{ secrets.DEPLOY_USER }}
+          DEPLOY_PATH: ${{ secrets.DEPLOY_PATH }}
+          SOURCE_SHA: ${{ needs.verify.outputs.source_sha }}
+        run: |
+          set -euo pipefail
+
+          port="${DEPLOY_PORT:-22}"
+          ssh_opts=(
+            -i "${HOME}/.ssh/deploy_key"
+            -o BatchMode=yes
+            -o StrictHostKeyChecking=yes
+            -o UserKnownHostsFile="${HOME}/.ssh/known_hosts"
+            -p "${port}"
+          )
+
+          ssh "${ssh_opts[@]}" "${DEPLOY_USER}@${DEPLOY_HOST}" \
+            "mkdir -p -- '${DEPLOY_PATH}'"
+
+          scp \
+            -i "${HOME}/.ssh/deploy_key" \
+            -o BatchMode=yes \
+            -o StrictHostKeyChecking=yes \
+            -o UserKnownHostsFile="${HOME}/.ssh/known_hosts" \
+            -P "${port}" \
+            "${RUNNER_TEMP}/deployment-${SOURCE_SHA}.tar.gz" \
+            "${DEPLOY_USER}@${DEPLOY_HOST}:${DEPLOY_PATH}/.incoming-${SOURCE_SHA}.tar.gz"
+
+      - name: Refresh deployment tooling without deleting runtime state
+        shell: bash
+        env:
+          DEPLOY_HOST: ${{ secrets.DEPLOY_HOST }}
+          DEPLOY_PORT: ${{ secrets.DEPLOY_PORT }}
+          DEPLOY_USER: ${{ secrets.DEPLOY_USER }}
+          DEPLOY_PATH: ${{ secrets.DEPLOY_PATH }}
+          SOURCE_SHA: ${{ needs.verify.outputs.source_sha }}
+        run: |
+          set -euo pipefail
+
+          port="${DEPLOY_PORT:-22}"
+          ssh_opts=(
+            -i "${HOME}/.ssh/deploy_key"
+            -o BatchMode=yes
+            -o StrictHostKeyChecking=yes
+            -o UserKnownHostsFile="${HOME}/.ssh/known_hosts"
+            -p "${port}"
+          )
+
+          ssh "${ssh_opts[@]}" "${DEPLOY_USER}@${DEPLOY_HOST}" \
+            bash -s -- "${DEPLOY_PATH}" "${SOURCE_SHA}" <<'REMOTE'
+          set -euo pipefail
+
+          deploy_path="$1"
+          source_sha="$2"
+          incoming="${deploy_path}/.incoming-${source_sha}.tar.gz"
+          preserve="$(mktemp -d)"
+
+          test -f "${incoming}"
+
+          preserve_path() {
+            local relative="$1"
+            local source="${deploy_path}/${relative}"
+            local target="${preserve}/${relative}"
+
+            if [[ -e "${source}" ]]; then
+              mkdir -p "$(dirname "${target}")"
+              mv "${source}" "${target}"
+            fi
+          }
+
+          restore_path() {
+            local relative="$1"
+            local source="${preserve}/${relative}"
+            local target="${deploy_path}/${relative}"
+
+            if [[ -e "${source}" ]]; then
+              mkdir -p "$(dirname "${target}")"
+              rm -rf "${target}"
+              mv "${source}" "${target}"
+            fi
+          }
+
+          cleanup() {
+            restore_path 'backend/.env.production'
+            restore_path 'backend/.env.staging'
+            restore_path 'backend/backups'
+            restore_path 'backend/ops/production/secrets'
+            restore_path 'backend/ops/production/.deployment-state'
+            rm -rf "${preserve}"
+          }
+          trap cleanup EXIT
+
+          preserve_path 'backend/.env.production'
+          preserve_path 'backend/.env.staging'
+          preserve_path 'backend/backups'
+          preserve_path 'backend/ops/production/secrets'
+          preserve_path 'backend/ops/production/.deployment-state'
+
+          rm -rf "${deploy_path}/backend" "${deploy_path}/frontend"
+          tar -xzf "${incoming}" -C "${deploy_path}"
+          rm -f "${incoming}"
+
+          restore_path 'backend/.env.production'
+          restore_path 'backend/.env.staging'
+          restore_path 'backend/backups'
+          restore_path 'backend/ops/production/secrets'
+          restore_path 'backend/ops/production/.deployment-state'
+
+          command -v docker >/dev/null
+          docker compose version >/dev/null
+          command -v pwsh >/dev/null
+          REMOTE
+
+      - name: Authenticate deployment host to GHCR
+        if: inputs.deployment_mode == 'Registry'
+        shell: bash
+        env:
+          DEPLOY_HOST: ${{ secrets.DEPLOY_HOST }}
+          DEPLOY_PORT: ${{ secrets.DEPLOY_PORT }}
+          DEPLOY_USER: ${{ secrets.DEPLOY_USER }}
+          GHCR_TOKEN: ${{ github.token }}
+          GHCR_USERNAME: ${{ github.actor }}
+        run: |
+          set -euo pipefail
+
+          port="${DEPLOY_PORT:-22}"
+
+          printf '%s' "${GHCR_TOKEN}" | ssh \
+            -i "${HOME}/.ssh/deploy_key" \
+            -o BatchMode=yes \
+            -o StrictHostKeyChecking=yes \
+            -o UserKnownHostsFile="${HOME}/.ssh/known_hosts" \
+            -p "${port}" \
+            "${DEPLOY_USER}@${DEPLOY_HOST}" \
+            "docker login ghcr.io --username '${GHCR_USERNAME}' --password-stdin"
+
+      - name: Deploy verified release
+        shell: bash
+        env:
+          DEPLOY_ENVIRONMENT: ${{ inputs.environment }}
+          DEPLOYMENT_MODE: ${{ inputs.deployment_mode }}
+          DEPLOY_HOST: ${{ secrets.DEPLOY_HOST }}
+          DEPLOY_PORT: ${{ secrets.DEPLOY_PORT }}
+          DEPLOY_USER: ${{ secrets.DEPLOY_USER }}
+          DEPLOY_PATH: ${{ secrets.DEPLOY_PATH }}
+          SOURCE_SHA: ${{ needs.verify.outputs.source_sha }}
+        run: |
+          set -euo pipefail
+
+          port="${DEPLOY_PORT:-22}"
+
+          args=(
+            pwsh -NoProfile
+            -File "${DEPLOY_PATH}/backend/ops/production/Invoke-Release.ps1"
+            -EnvironmentName "${DEPLOY_ENVIRONMENT}"
+            -SourceSha "${SOURCE_SHA}"
+            -DeploymentMode "${DEPLOYMENT_MODE}"
+          )
+
+          printf -v remote_command '%q ' "${args[@]}"
+
+          ssh \
+            -i "${HOME}/.ssh/deploy_key" \
+            -o BatchMode=yes \
+            -o StrictHostKeyChecking=yes \
+            -o UserKnownHostsFile="${HOME}/.ssh/known_hosts" \
+            -p "${port}" \
+            "${DEPLOY_USER}@${DEPLOY_HOST}" \
+            "${remote_command}"
+
+      - name: Record deployment summary
+        shell: bash
+        env:
+          SOURCE_SHA: ${{ needs.verify.outputs.source_sha }}
+          DEPLOY_ENVIRONMENT: ${{ inputs.environment }}
+          DEPLOYMENT_MODE: ${{ inputs.deployment_mode }}
+        run: |
+          {
+            echo "## Deployment complete"
+            echo
+            echo "- Environment: \`${DEPLOY_ENVIRONMENT}\`"
+            echo "- Source SHA: \`${SOURCE_SHA}\`"
+            echo "- Mode: \`${DEPLOYMENT_MODE}\`"
+          } >> "${GITHUB_STEP_SUMMARY}"
