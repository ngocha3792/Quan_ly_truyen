+
+      - name: Smoke test backend migration and runtime images
+        shell: bash
+        run: |
+          set -euo pipefail
+
+          database_url='postgresql://postgres:postgres@127.0.0.1:5432/quan_ly_truyen_container_smoke?schema=public'
+          redis_url='redis://127.0.0.1:6379/0'
+          api_container_id=''
+          worker_container_id=''
+
+          cleanup() {
+            for container_id in "${worker_container_id}" "${api_container_id}"; do
+              if test -n "${container_id}"; then
+                docker logs "${container_id}" || true
+                docker rm --force "${container_id}" >/dev/null 2>&1 || true
+              fi
+            done
+          }
+
+          trap cleanup EXIT
+
+          migrate_user="$(
+            docker inspect \
+              --format '{{.Config.User}}' \
+              quan-ly-truyen-backend-migrate:ci
+          )"
+
+          if test -z "${migrate_user}" -o "${migrate_user}" = "root" -o "${migrate_user}" = "0"; then
+            echo 'Backend migration image must declare a non-root runtime user.'
+            exit 1
+          fi
+
+          docker run \
+            --rm \
+            --network host \
+            --read-only \
+            --cap-drop ALL \
+            --security-opt no-new-privileges \
+            --tmpfs /tmp:size=64m,mode=1777 \
+            --env DATABASE_URL="${database_url}" \
+            quan-ly-truyen-backend-migrate:ci
+
+          common_env=(
+            --env-file backend/.env.example
+            --env NODE_ENV=test
+            --env DATABASE_URL="${database_url}"
+            --env REDIS_ENABLED=true
+            --env REDIS_URL="${redis_url}"
+            --env REDIS_KEY_PREFIX=qlt:ci:container-smoke
+            --env MAIL_ENABLED=false
+            --env CLOUDINARY_ENABLED=false
+            --env OBSERVABILITY_ENABLED=false
+            --env METRICS_ENABLED=false
+            --env OTEL_SDK_DISABLED=true
+            --env SWAGGER_ENABLED=false
+            --env LOG_LEVEL=warn
+            --env LOG_PRETTY=false
+            --env ALLOW_IN_MEMORY_INFRASTRUCTURE_FALLBACK=false
+          )
+
+          api_container_id="$(
+            docker run \
+              --detach \
+              --network host \
+              --read-only \
+              --cap-drop ALL \
+              --security-opt no-new-privileges \
+              --tmpfs /tmp:size=64m,mode=1777 \
+              "${common_env[@]}" \
+              --env QUEUE_ENABLED=false \
+              quan-ly-truyen-backend:ci
+          )"
+
+          api_ready=false
+
+          for attempt in $(seq 1 60); do
+            if curl \
+              --fail \
+              --silent \
+              http://127.0.0.1:3000/api/v1/health/live \
+              >/dev/null \
+              && curl \
+                --fail \
+                --silent \
+                http://127.0.0.1:3000/api/v1/health/ready \
+                >/dev/null
+            then
+              api_ready=true
+              break
+            fi
+
+            if test "$(docker inspect --format '{{.State.Running}}' "${api_container_id}")" != 'true'; then
+              echo 'Backend API container exited before becoming ready.'
+              exit 1
+            fi
+
+            sleep 1
+          done
+
+          if test "${api_ready}" != 'true'; then
+            echo 'Backend API container failed liveness/readiness smoke checks.'
+            exit 1
+          fi
+
+          worker_container_id="$(
+            docker run \
+              --detach \
+              --network host \
+              --read-only \
+              --cap-drop ALL \
+              --security-opt no-new-privileges \
+              --tmpfs /tmp:size=64m,mode=1777 \
+              "${common_env[@]}" \
+              --env QUEUE_ENABLED=true \
+              --env QUEUE_WORKER_HEARTBEAT_ENABLED=true \
+              --env WORKER_ROLE=queue \
+              quan-ly-truyen-backend:ci \
+              node dist/worker.js
+          )"
+
+          worker_ready=false
+
+          for attempt in $(seq 1 45); do
+            if docker exec \
+              "${worker_container_id}" \
+              node dist/healthcheck/worker-heartbeat.healthcheck.js
+            then
+              worker_ready=true
+              break
+            fi
+
+            if test "$(docker inspect --format '{{.State.Running}}' "${worker_container_id}")" != 'true'; then
+              echo 'Backend worker container exited before its heartbeat became healthy.'
+              exit 1
+            fi
+
+            sleep 1
+          done
+
+          if test "${worker_ready}" != 'true'; then
+            echo 'Backend worker container failed its heartbeat smoke check.'
+            exit 1
+          fi
