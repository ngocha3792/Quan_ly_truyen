diff --git a/backend/src/modules/auth/infrastructure/persistence/prisma/repositories/prisma-admin-user-security.persistence.ts b/backend/src/modules/auth/infrastructure/persistence/prisma/repositories/prisma-admin-user-security.persistence.ts
