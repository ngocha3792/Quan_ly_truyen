+@media (max-width: 600px) { .comments-shell { padding: .8rem; } .comment-editor { grid-template-columns: 1fr; } .comment-item.reply,.comment-item.reply.depth-two,.reply-editor,.reply-editor.nested,.load-replies { margin-left: .6rem; } }
