+      SEXUAL_CONTENT: 'Nội dung tình dục',
+      VIOLENCE: 'Bạo lực',
+      COPYRIGHT: 'Bản quyền',
+      MISINFORMATION: 'Thông tin sai lệch',
+      OTHER: 'Khác',
+    })[reason];
+  }
+}
