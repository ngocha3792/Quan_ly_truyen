     }
 
     const backendMessage = body?.error?.message;
+    const retryAfterSeconds = readRetryAfterSeconds(body);
+
+    if (error.status === 429 && retryAfterSeconds !== null) {
+      const message = typeof backendMessage === 'string' && backendMessage.trim()
+        ? backendMessage.trim()
