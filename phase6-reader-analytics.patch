+  }
+
+  @Get('stories/:storyId')
+  story(
+    @CurrentUserId() userId: string | undefined,
+    @Param('storyId', new ParseUUIDPipe({ version: '4' })) storyId: string,
+    @Query() query: AnalyticsDateRangeRequest,
+  ) {
+    return this.analytics.story(userId, storyId, query.from, query.to);
+  }
+}
